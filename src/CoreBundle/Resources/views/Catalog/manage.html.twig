{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:list-check', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Manage model list'|trans }}{% endblock title %}

{% block heading %}
    <a href="{{ path('_settings') }}" class="btn btn-outline-secondary">
        {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
        {{ 'Back to settings'|trans }}
    </a>
{% endblock %}

{% block content %}
    <twig:Ui:Card>
        <p class="text-secondary">
            {{ 'This is the list of phone models suggested when you type a model on line 1 of an invoice. Keep one model per line. Paste a fresh list any time and press Save - what you see here is exactly the list that gets used. If you type a model that is not on the list, it still works fine, it just will not be suggested until you add it here.'|trans }}
        </p>

        <form method="post" action="{{ path('_model_catalog_manage') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('model.catalog') }}">

            <div class="mb-2 d-flex justify-content-between align-items-end">
                <label for="models" class="form-label mb-0">{{ 'Model list (one per line)'|trans }}</label>
                <small class="text-secondary"><span id="model-count">{{ count }}</span> {{ 'models'|trans }}</small>
            </div>

            <textarea name="models" id="models" class="form-control font-monospace" rows="18" spellcheck="false" placeholder="{{ 'One model per line, e.g. Sony Xperia 1 VI'|trans }}">{{ models }}</textarea>

            <div class="mt-3 d-flex flex-wrap gap-2">
                <button type="submit" name="action" value="save" class="btn btn-primary">
                    {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                    {{ 'Save list'|trans }}
                </button>
                <button type="submit" name="action" value="reset" class="btn btn-outline-secondary"
                        onclick="return confirm('{{ 'Replace your list with the full built-in model list for all brands?'|trans|e('js') }}');">
                    {{ ux_icon('tabler:refresh', {width: 18, height: 18}) }}
                    {{ 'Restore default list'|trans }}
                </button>
            </div>
        </form>
    </twig:Ui:Card>

    <script>
        (function () {
            var ta = document.getElementById('models');
            var counter = document.getElementById('model-count');
            if (!ta || !counter) { return; }
            function count() {
                var lines = ta.value.split(/[\r\n,]+/).map(function (s) { return s.trim(); }).filter(Boolean);
                var seen = {};
                lines.forEach(function (l) { seen[l.toLowerCase()] = 1; });
                counter.textContent = Object.keys(seen).length;
            }
            ta.addEventListener('input', count);
        })();
    </script>
{% endblock content %}
