{% extends '@SolidInvoiceCore/Layout/base.html.twig' %}

{% block scripts %}
    {% set script = block("script") ?? null %}

    {% if script is not empty %}
        <script>
            {{ script|raw }}
        </script>
    {% endif %}
{% endblock %}

{% block header %}
    {% include "@SolidInvoiceCore/Menu/top.html.twig" with {"title" : block('title') ?? '', "header_content" : header_content|default('')} %}
{% endblock header %}

{% block footer %}
{% endblock footer %}

{% block body_bottom %}
    <div id="modal-container" class="modal" tabindex="-1"></div>
{% endblock body_bottom %}

{% block body %}
    <aside class="navbar navbar-vertical navbar-expand-lg navbar-dark d-print-none" data-bs-theme="dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebar-menu" aria-controls="sidebar-menu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-brand">
                <a href="{{ path('_dashboard') }}" aria-label="{{ company_name() }}" class="d-flex align-items-center text-decoration-none link-white">
                    <small class="d-flex flex-column text-wrap lh-sm text-start">
                        {{ company_name() }}
                    </small>
                </a>
            </div>

            <div class="navbar-nav flex-row d-lg-none">
                {# On a phone the top bar is hidden altogether, so without this the
                   Marketplace is behind the hamburger - which is exactly how a
                   member described it: log in, open the menu, find Marketplace,
                   then search. This is the whole journey in one tap. #}
                <div class="nav-item">
                    <a href="{{ path('_marketplace') }}" class="nav-link px-2" aria-label="{{ 'Marketplace'|trans }}" title="{{ 'Marketplace'|trans }}">
                        {{ ux_icon('tabler:building-store', {width: 22, height: 22}) }}
                    </a>
                </div>

                <div class="nav-item dropdown">
                    <a href="#" class="nav-link d-flex lh-1 text-reset p-0 px-2" data-bs-toggle="dropdown" aria-label="Open user menu">
                        <span class="avatar avatar-sm">
                            <img src="https://gravatar.com/avatar/{{ app.user.email|md5 }}?d=mm" alt="{{ 'User Image'|trans }}">
                        </span>
                        <div class="d-none d-xl-block ps-2">
                            <div>{{ app.user.email }}</div>
                        </div>
                    </a>
                    <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                        {# Signing in now drops you straight into the business you
                           were last in, so the list of businesses is no longer
                           shown at every login - which means this has to be the
                           way back to it. On a phone the top bar (and the company
                           switcher that lives in it) is hidden altogether, so
                           without this line somebody with two businesses would
                           have had to log out to change between them. #}
                        {% if not is_custom_domain() and app.user.companies|length > 1 %}
                            {# One tap per business, the same as the desktop
                               switcher. Pointing this at the pick-a-business
                               page instead would have been a dead end for a
                               business whose subscription is paused: the SaaS
                               listener takes over every route except
                               _switch_company, so the page you would use to get
                               out of it never renders. #}
                            <span class="dropdown-header text-truncate">{{ company_name() }}</span>
                            {% for company in app.user.companies|filter(v => not v.id.equals(company_id())) %}
                                <a href="{{ path('_switch_company', {'id': company.id}) }}" class="dropdown-item d-flex align-items-center gap-2">
                                    {{ ux_icon('tabler:switch-horizontal', {width: 16, height: 16}) }}
                                    <span class="text-truncate">{{ company }}</span>
                                </a>
                            {% endfor %}
                            <div class="dropdown-divider"></div>
                        {% endif %}
                        <a href="{{ path('_profile') }}" class="dropdown-item d-flex align-items-center gap-2">
                            {{ ux_icon('tabler:user', {width: 16, height: 16}) }}
                            {{ 'Profile'|trans }}
                        </a>
                        <div class="dropdown-divider"></div>
                        <a href="{{ path('_api_keys_index') }}" class="dropdown-item d-flex align-items-center gap-2">
                            {{ ux_icon('tabler:lock', {width: 16, height: 16}) }}{{ 'API Keys'|trans }}
                        </a>
                        <twig:Ui:Security:LogoutLink />
                    </div>
                </div>
            </div>

            <div class="collapse navbar-collapse" id="sidebar-menu">
                <div class="d-flex flex-column">
                    {{ render_menu('sidebar') }}

                    {% if block('sidebar') is defined %}
                        <nav class="mt-2">
                            {{ block('sidebar') }}
                        </nav>
                    {% endif %}
                </div>
            </div>
        </div>
    </aside>
    {{ block('header') }}

    <div class="page-wrapper">
        {% if block('title') is defined and block('title')|trim is not empty %}
            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            {% if block('pretitle') is defined and block('pretitle')|trim is not empty %}
                                <div class="page-pretitle">
                                    {{ block('pretitle')|raw }}
                                </div>
                            {% endif %}
                            <h2 class="page-title">
                                {{ block('title')|raw }}
                            </h2>
                        </div>
                        {% if block('heading') is defined and block('heading')|trim is not empty %}
                            <div class="col-auto ms-auto d-print-none">
                                <div class="btn-list">
                                    {{ block('heading') }}
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        <div class="page-body">
            <div class="container-xl">
                {% include "@SolidInvoiceCore/flash.html.twig" %}

                {{ block('content') is defined ? block('content') }}
            </div>
        </div>
    </div>
{% endblock body %}
