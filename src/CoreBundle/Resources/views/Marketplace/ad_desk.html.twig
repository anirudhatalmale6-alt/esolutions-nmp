 # The platform owner's advert desk. Two halves: the four places on the
 # Marketplace and who is in them, then every advert that has been written,
 # placed or not. Super-user only - the action checks it too.
 #}

{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:photo', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Marketplace Adverts'|trans }}{% endblock title %}

{% block content %}
    <twig:Ui:Card>
        <h3 class="mb-1">{{ 'The four places'|trans }}</h3>
        <p class="text-secondary" style="max-width: 760px;">
            {{ 'These sit at the top of the Marketplace, under the search box. Putting an advert into a place that is already taken moves the other one out - there is only ever one advert in a place.'|trans }}
        </p>

        <div class="row g-3 mb-4">
            {% for slot, ad in slots %}
                <div class="col-12 col-md-6 col-xl-3">
                    <div class="border rounded h-100 p-3">
                        <div class="text-secondary small mb-2">{{ 'Place %n%'|trans({'%n%': slot}) }}</div>
                        {% if ad %}
                            {% set image = marketplace_media(ad.imagePath) %}
                            {% if image %}
                                <img src="{{ image }}" alt="{{ ad.title }}" class="d-block rounded mb-2" style="width: 100%; height: auto;">
                            {% endif %}
                            <div class="fw-semibold">{{ ad.title }}</div>
                            <div class="text-secondary small">{{ ad.businessName ?: 'Our own advert'|trans }}</div>
                        {% else %}
                            <div class="text-secondary py-4 text-center">{{ 'Empty'|trans }}</div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>

        {# The owner writing one himself. He sells these places, so he has to be
           able to fill all four without waiting for a member to send something
           in - and an empty place is better filled with our own advert than
           left blank. #}
        <h3 class="mb-1">{{ 'Write an advert'|trans }}</h3>
        <p class="text-secondary" style="max-width: 760px;">
            {{ 'For one of your own, or for a member who sent you the picture and the wording by WhatsApp. Leave the place empty to save it without putting it up yet.'|trans }}
        </p>

        <form method="post" action="{{ path('_marketplace_ads') }}" enctype="multipart/form-data" class="mb-4" style="max-width: 760px;">
            <input type="hidden" name="_token" value="{{ csrf_token('marketplace.ads') }}">
            <input type="hidden" name="action" value="create">

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="new-title">{{ 'Headline'|trans }}</label>
                    <input class="form-control" type="text" id="new-title" name="title" maxlength="120" required
                           placeholder="{{ 'e.g. iPhone 16 Pro Max - 50 pcs'|trans }}">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="new-caption">{{ 'One line underneath'|trans }}</label>
                    <input class="form-control" type="text" id="new-caption" name="caption" maxlength="255"
                           placeholder="{{ 'e.g. Sealed, UAE spec, ready to ship'|trans }}">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="new-link">{{ 'Where a tap goes'|trans }}</label>
                    <input class="form-control" type="text" id="new-link" name="link_url" maxlength="255"
                           placeholder="{{ 'e.g. b2bnetwork.ae, or leave empty'|trans }}">
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="new-image">{{ 'Picture'|trans }}</label>
                    <input class="form-control" type="file" id="new-image" name="image" accept=".jpg,.jpeg,.png,.webp" required>
                    <div class="form-hint mt-1">{{ 'Landscape works best - about four wide to three tall.'|trans }}</div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="new-slot">{{ 'Place'|trans }}</label>
                    <select class="form-select" id="new-slot" name="slot">
                        <option value="0">{{ 'Not on the page yet'|trans }}</option>
                        {% for slot in 1..slotCount %}
                            <option value="{{ slot }}">{{ 'Place %n%'|trans({'%n%': slot}) }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary">
                        {{ ux_icon('tabler:plus', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Save advert'|trans }}
                    </button>
                </div>
            </div>
        </form>

        <hr class="my-4">

        <h3 class="mb-1">{{ 'Every advert'|trans }}</h3>
        <p class="text-secondary" style="max-width: 760px;">
            {{ 'Members with the Classifieds button switched on write their own advert. Nothing appears on the Marketplace until you give it a place here.'|trans }}
        </p>

        {% if ads is empty %}
            <div class="text-secondary py-4">{{ 'Nobody has written an advert yet.'|trans }}</div>
        {% else %}
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                    <tr>
                        <th style="width: 210px;">{{ 'Picture'|trans }}</th>
                        <th>{{ 'Advert'|trans }}</th>
                        <th>{{ 'Business'|trans }}</th>
                        <th>{{ 'Where'|trans }}</th>
                        <th class="text-end">{{ 'Action'|trans }}</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for ad in ads %}
                        {% set image = marketplace_media(ad.imagePath) %}
                        <tr>
                            <td>
                                {% if image %}
                                    <img src="{{ image }}" alt="{{ ad.title }}" class="rounded mb-1" style="width: 120px; height: auto;">
                                {% else %}
                                    <div class="text-secondary small mb-1">{{ 'No picture'|trans }}</div>
                                {% endif %}
                                {# Swapping the picture without making anyone
                                   rewrite the wording - usually a member sends a
                                   better one over WhatsApp. #}
                                <form method="post" action="{{ path('_marketplace_ads') }}" enctype="multipart/form-data">
                                    <input type="hidden" name="_token" value="{{ csrf_token('marketplace.ads') }}">
                                    <input type="hidden" name="ad" value="{{ ad.id }}">
                                    <input type="hidden" name="action" value="picture">
                                    <input class="form-control form-control-sm mb-1" type="file" name="image"
                                           accept=".jpg,.jpeg,.png,.webp" aria-label="{{ 'New picture'|trans }}">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'Replace'|trans }}</button>
                                </form>
                            </td>
                            <td>
                                <div class="fw-semibold">{{ ad.title }}</div>
                                {% if ad.caption %}<div class="text-secondary small">{{ ad.caption }}</div>{% endif %}
                                {% if ad.linkUrl %}<div class="text-secondary small text-truncate" style="max-width: 320px;">{{ ad.linkUrl }}</div>{% endif %}
                            </td>
                            <td>{{ ad.businessName ?: 'Our own advert'|trans }}</td>
                            <td>
                                {% if ad.slot %}
                                    <span class="badge bg-green text-white">{{ 'Place %n%'|trans({'%n%': ad.slot}) }}</span>
                                {% else %}
                                    <span class="text-secondary small">{{ 'Not showing'|trans }}</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <form method="post" action="{{ path('_marketplace_ads') }}" class="d-inline-flex align-items-center gap-1">
                                    <input type="hidden" name="_token" value="{{ csrf_token('marketplace.ads') }}">
                                    <input type="hidden" name="ad" value="{{ ad.id }}">
                                    <input type="hidden" name="action" value="place">
                                    <select name="slot" class="form-select form-select-sm" style="width: auto;" aria-label="{{ 'Place'|trans }}">
                                        {% for slot in 1..slotCount %}
                                            <option value="{{ slot }}"{% if ad.slot == slot %} selected{% endif %}>{{ 'Place %n%'|trans({'%n%': slot}) }}</option>
                                        {% endfor %}
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-primary">{{ 'Put up'|trans }}</button>
                                </form>

                                {% if ad.slot %}
                                    <form method="post" action="{{ path('_marketplace_ads') }}" class="d-inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('marketplace.ads') }}">
                                        <input type="hidden" name="ad" value="{{ ad.id }}">
                                        <input type="hidden" name="action" value="pull">
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">{{ 'Take down'|trans }}</button>
                                    </form>
                                {% endif %}

                                <form method="post" action="{{ path('_marketplace_ads') }}" class="d-inline"
                                      onsubmit="return confirm('{{ 'Delete this advert? The picture goes with it.'|trans|e('js') }}');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('marketplace.ads') }}">
                                    <input type="hidden" name="ad" value="{{ ad.id }}">
                                    <input type="hidden" name="action" value="delete">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'Delete'|trans }}</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </twig:Ui:Card>
{% endblock %}
