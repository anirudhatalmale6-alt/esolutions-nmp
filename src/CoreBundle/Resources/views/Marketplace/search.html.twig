 #
 # Public, no-login Marketplace search - the home page. Self-contained (inline
 # CSS), text-only and mobile-first by design. Guests get a seller-hidden roll-up
 # and a prompt to log in; signed-in portal users see the business and a Chat Now
 # WhatsApp button per seller. Results are cards (not a table) so they read well
 # on a phone.
 #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'Mobile Phones Wholesale & Distributors'|trans }}</title>
    <style>
        :root { --bg:#f6f7f9; --card:#fff; --ink:#1a2027; --muted:#6b7480; --line:#e5e8ec; --brand:#0b6bcb; --wa:#25d366; --chip:#eef2f6; }
        * { box-sizing: border-box; }
        html, body { margin:0; }
        body { font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; background:var(--bg); color:var(--ink); -webkit-text-size-adjust:100%; }
        .wrap { max-width: 760px; margin: 0 auto; padding: 18px 14px 60px; }
        .topbar { display:flex; justify-content:flex-end; align-items:center; gap:8px; min-height:26px; }
        .topbar a { text-decoration:none; }
        .authlink { color:var(--brand); font-weight:600; font-size:.9rem; padding:5px 12px; border:1px solid var(--brand); border-radius:999px; }
        .authlink.solid { background:var(--brand); color:#fff; }
        .topbar .sep { color:var(--muted); }
        header.top { text-align:center; padding: 6px 0 6px; }
        header.top h1 { margin:0; font-size: 1.4rem; }
        header.top p { margin:.35rem 0 0; color:var(--muted); font-size:.9rem; }
        form.search { display:flex; gap:8px; margin: 16px 0 4px; position: sticky; top: 8px; }
        form.search input[type=text] { flex:1; min-width:0; padding: 13px 14px; font-size:16px; border:1px solid var(--line); border-radius:12px; background:var(--card); color:var(--ink); }
        form.search button { padding: 13px 16px; font-size:16px; font-weight:600; border:0; border-radius:12px; background:var(--brand); color:#fff; cursor:pointer; }
        .hint { color:var(--muted); font-size:.9rem; margin:12px 4px; text-align:center; }
        .count { color:var(--muted); font-size:.82rem; margin:14px 4px 6px; }
        .result { background:var(--card); border:1px solid var(--line); border-radius:12px; padding:14px; margin-top:10px; display:flex; flex-wrap:wrap; align-items:center; gap:10px 14px; }
        .result .info { flex:1 1 180px; min-width:0; }
        .result .model { font-weight:700; font-size:1.02rem; word-break:break-word; }
        .result .biz { color:var(--muted); font-size:.9rem; margin-top:2px; }
        .result .loc { color:var(--muted); font-size:.85rem; margin-top:3px; }
        .result .loc .flag { font-size:1rem; }
        .chips { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
        .chip { background:var(--chip); color:var(--ink); border-radius:999px; padding:5px 11px; font-size:.82rem; font-weight:600; white-space:nowrap; }
        .chip b { font-weight:800; }
        .chat { display:inline-flex; align-items:center; gap:6px; padding:11px 16px; background:var(--wa); color:#0a2e14; font-weight:700; text-decoration:none; border-radius:10px; font-size:.9rem; white-space:nowrap; }
        .nowa { color:var(--muted); font-size:.82rem; }
        .empty { text-align:center; color:var(--muted); background:var(--card); border:1px solid var(--line); border-radius:12px; padding: 30px 16px; margin-top:12px; }
        .notice { background:#eef4ff; border:1px solid #d6e4ff; color:#1c3d6e; border-radius:12px; padding:13px 15px; margin-top:14px; font-size:.92rem; text-align:center; }
        .notice a { display:inline-block; margin-top:8px; background:var(--brand); color:#fff; text-decoration:none; font-weight:600; padding:9px 16px; border-radius:10px; }
        footer.foot { text-align:center; color:var(--muted); font-size:.8rem; margin-top:26px; }
        @media (max-width: 480px) {
            .result { align-items:stretch; }
            .result .info { flex-basis:100%; }
            .chat { width:100%; justify-content:center; }
        }
        @media (prefers-color-scheme: dark) {
            :root { --bg:#12151a; --card:#1a1f27; --ink:#e8ebef; --muted:#95a0ad; --line:#2a313b; --chip:#242b34; }
            .notice { background:#14233b; border-color:#25406b; color:#bcd4ff; }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="topbar">
        {% if loggedIn %}
            <a class="authlink solid" href="{{ path('_dashboard') }}">{{ 'My Portal'|trans }}</a>
        {% else %}
            <a class="authlink" href="{{ path('_register') }}">{{ 'Register'|trans }}</a>
            <span class="sep">|</span>
            <a class="authlink solid" href="{{ path('_login_main') }}">{{ 'Login'|trans }}</a>
        {% endif %}
    </div>

    <header class="top">
        <h1>{{ 'Mobile Phones Wholesale & Distributors'|trans }}</h1>
        <p>{{ 'Search for stock inventory'|trans }}</p>
    </header>

    <form class="search" method="get" action="{{ path('_marketplace') }}" role="search">
        <input type="text" name="q" value="{{ query }}" placeholder="{{ 'Search a model, e.g. S26 Ultra'|trans }}"
               autocomplete="off" autocapitalize="none" autocorrect="off" enterkeyhint="search" aria-label="{{ 'Search a phone model'|trans }}" autofocus>
        <button type="submit">{{ 'Search'|trans }}</button>
    </form>

    {% if not searched %}
        <p class="hint">{{ 'Type a model above - spacing and capitals do not matter.'|trans }}</p>
    {% elseif results is empty %}
        <div class="empty">{{ 'No listed seller has "%q%" in stock right now.'|trans({'%q%': query}) }}</div>
    {% elseif loggedIn %}
        <div class="count">{{ '%n% result(s)'|trans({'%n%': results|length}) }}</div>
        {% for r in results %}
            <div class="result">
                <div class="info">
                    <div class="model">{{ r.business }}</div>
                    {% set place = r.city ?: r.country %}
                    {% if r.flag is not empty or place is not empty %}
                        <div class="loc">{% if r.flag is not empty %}<span class="flag">{{ r.flag }}</span> {% endif %}{{ place }}</div>
                    {% endif %}
                </div>
                <div class="chips">
                    <span class="chip">{{ r.model }}</span>
                    <span class="chip">{{ 'Qty'|trans }} <b>{{ r.qty }}</b></span>
                </div>
                {% if r.chatUrl is not empty %}
                    <a class="chat" href="{{ r.chatUrl }}" target="_blank" rel="noopener">{{ 'Chat Now'|trans }}</a>
                {% else %}
                    <span class="nowa">{{ 'No WhatsApp'|trans }}</span>
                {% endif %}
            </div>
        {% endfor %}
    {% else %}
        {# Guest: seller identity and chat hidden. #}
        <div class="count">{{ '%n% model(s) found'|trans({'%n%': results|length}) }}</div>
        {% for r in results %}
            <div class="result">
                <div class="info">
                    <div class="model">{{ r.model }}</div>
                </div>
                <div class="chips">
                    <span class="chip">{{ r.qty }} {{ 'available'|trans }}</span>
                </div>
                <a class="chat" href="{{ path('_login_main') }}">{{ 'Chat'|trans }}</a>
            </div>
        {% endfor %}
    {% endif %}

    <footer class="foot">{{ 'eSolutions'|trans }}</footer>
</div>
</body>
</html>
