 # Public, no-login Marketplace search - the home page. Self-contained (inline
 # CSS), text-only and mobile-first by design. Guests get a seller-hidden roll-up
 # and a prompt to log in; signed-in portal users see the business and a Chat Now
 # WhatsApp button per seller. Results are cards (not a table) so they read well
 # on a phone: the matched model(s) sit on top, a hairline divider, then the
 # seller row (display picture + business + location) and Chat.
 #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'Mobile Phones Wholesale & Distributors'|trans }}</title>
    <style>
        :root { --bg:#f7f8fa; --card:#ffffff; --ink:#20242c; --muted:#8b919b; --line:#e8eaef;
                --chip:#f2f3f6; --accent:#20242c; --accent-ink:#ffffff; --wa:#25d366; }
        * { box-sizing: border-box; }
        html, body { margin:0; overflow-x:hidden; }
        body { font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; color:var(--ink); background:var(--bg); min-height:100vh; -webkit-text-size-adjust:100%; }
        .wrap { max-width: 680px; margin: 0 auto; padding: 16px 16px 64px; }
        .topbar { display:flex; justify-content:flex-end; align-items:center; gap:8px; min-height:26px; }
        .topbar a { text-decoration:none; }
        .authlink { color:var(--ink); font-weight:600; font-size:.9rem; padding:6px 14px; border:1px solid var(--line); border-radius:999px; background:var(--card); }
        .authlink.solid { background:var(--accent); color:var(--accent-ink); border-color:var(--accent); }
        .topbar .sep { color:var(--muted); }
        header.top { text-align:center; padding: 24px 0 6px; }
        header.top h1 { margin:0; white-space:nowrap; font-size: clamp(0.8rem, 4.1vw, 1.9rem); font-weight:700; letter-spacing:-.4px; color:var(--ink); }
        header.top p { margin:.45rem 0 0; color:var(--muted); font-size:.92rem; }
        form.search { display:flex; gap:8px; margin: 20px 0 6px; position: sticky; top: 10px; z-index:5; }
        form.search input[type=text] { flex:1; min-width:0; padding: 14px 18px; font-size:16px; border:1px solid var(--line); border-radius:12px; background:var(--card); color:var(--ink); outline:none; box-shadow:0 1px 2px rgba(0,0,0,.04); }
        form.search input[type=text]:focus { border-color:#c3c8d0; }
        form.search input::placeholder { color:#aab0ba; font-weight:400; }
        form.search button { padding: 0 20px; font-size:15px; font-weight:600; border:0; border-radius:12px; background:var(--accent); color:var(--accent-ink); cursor:pointer; }
        .count { color:var(--muted); font-size:.82rem; margin:16px 4px 8px; }

        .result { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin-top:10px; }

        /* Seller header on top: display picture (portal/company logo placeholder)
           + business/location. Text kept un-bold for a calm, minimal look. */
        .vendor { display:flex; align-items:center; gap:12px; }
        .dp { width:40px; height:40px; border-radius:50%; background:var(--chip); color:var(--ink); display:flex; align-items:center; justify-content:center; font-weight:500; font-size:1rem; flex:0 0 auto; overflow:hidden; }
        /* Logos sit on a white circle so a transparent or black-on-transparent
           logo never renders as a dark/empty disc (looks right in dark mode too),
           and "contain" shows the whole logo instead of cropping a wordmark. */
        img.dp { object-fit:contain; background:#ffffff; padding:4px; }
        .dp.generic { font-size:1.15rem; }
        .vinfo { flex:1 1 auto; min-width:0; }
        .vinfo .bname { font-weight:500; font-size:1rem; line-height:1.3; word-break:break-word; }
        .vinfo .loc { color:var(--muted); font-size:.85rem; margin-top:2px; }
        .vinfo .loc .flag { font-size:1rem; }

        /* Light hairline running through the card. */
        .divider { height:1px; background:var(--line); margin:13px 0; }

        /* Matched model(s) with quantity. */
        .items { display:flex; flex-direction:column; gap:8px; }
        .item { display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .item .mname { font-weight:500; font-size:1rem; line-height:1.3; word-break:break-word; text-align:left; }
        .chip { background:var(--chip); color:var(--ink); border-radius:999px; padding:5px 11px; font-size:.8rem; font-weight:500; white-space:nowrap; flex:0 0 auto; }
        .chip b { font-weight:600; }

        /* Chat action at the bottom of the card. */
        .cta { display:flex; justify-content:flex-end; margin-top:13px; }
        .chat { display:inline-flex; align-items:center; gap:6px; padding:11px 18px; background:var(--wa); color:#0a2e14; font-weight:600; text-decoration:none; border-radius:12px; font-size:.9rem; white-space:nowrap; }
        .nowa { color:var(--muted); font-size:.82rem; }

        .empty { text-align:center; color:var(--muted); background:var(--card); border:1px solid var(--line); border-radius:14px; padding: 30px 16px; margin-top:12px; }
        footer.foot { text-align:center; color:var(--muted); font-size:.8rem; margin-top:30px; }
        @media (max-width: 480px) {
            .cta { margin-top:12px; }
            .chat { width:100%; justify-content:center; }
        }
        @media (prefers-color-scheme: dark) {
            :root { --bg:#0f1216; --card:#171b22; --ink:#e8ebef; --muted:#98a2ad; --line:#272d37; --chip:#222831; --accent:#e9ecf1; --accent-ink:#12151a; }
            form.search input[type=text]:focus { border-color:#3a4150; }
        }
    </style>
</head>
<body>
<div class="wrap">
    <div class="topbar">
        {% if loggedIn %}
            <a class="authlink solid" href="{{ path('_dashboard') }}">{{ 'My Portal'|trans }}</a>
        {% else %}
            <a class="authlink" href="{{ path('_register') }}">{{ 'Register'|trans }}</a>
            <span class="sep">|</span>
            <a class="authlink solid" href="{{ path('_login_main') }}">{{ 'Login'|trans }}</a>
        {% endif %}
    </div>

    <header class="top">
        <h1>{{ 'Mobile Phones Wholesale & Distributors'|trans }}</h1>
        <p>{{ 'Search for stock inventory'|trans }}</p>
    </header>

    <form class="search" method="get" action="{{ path('_marketplace') }}" role="search">
        <input type="text" name="q" value="{{ query }}" placeholder="{{ 'Search a model, e.g. S26 Ultra'|trans }}"
               autocomplete="off" autocapitalize="none" autocorrect="off" enterkeyhint="search" aria-label="{{ 'Search a phone model'|trans }}" autofocus>
        <button type="submit">{{ 'Search'|trans }}</button>
    </form>

    {% if searched %}
        {% if results is empty %}
            <div class="empty">{{ 'No listed seller has "%q%" in stock right now.'|trans({'%q%': query}) }}</div>
        {% else %}
            <div class="count">{{ '%n% seller(s)'|trans({'%n%': results|length}) }}</div>
            {% for g in results %}
                {% set place = g.city ?: g.country %}
                <div class="result">
                    {# Seller header on top: display picture + business/location.
                       Guests never see the business name, so their display picture
                       stays generic - it must not leak the hidden initial. #}
                    <div class="vendor">
                        {% if loggedIn and g.business is not empty %}
                            {% if g.logo is not empty %}
                                <img class="dp" src="{{ g.logo }}" alt="{{ g.business }}">
                            {% else %}
                                <div class="dp">{{ g.business|trim|first|upper }}</div>
                            {% endif %}
                        {% else %}
                            <div class="dp generic">🏬</div>
                        {% endif %}
                        <div class="vinfo">
                            {% if loggedIn and g.business is not empty %}
                                <div class="bname">{{ g.business }}</div>
                                {% if g.flag is not empty or place is not empty %}
                                    <div class="loc">{% if g.flag is not empty %}<span class="flag">{{ g.flag }}</span> {% endif %}{{ place }}</div>
                                {% endif %}
                            {% else %}
                                <div class="bname">{% if g.flag is not empty %}<span class="flag">{{ g.flag }}</span> {% endif %}{{ place ?: 'Verified seller'|trans }}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="divider"></div>

                    {# Matched model(s) with quantity. #}
                    <div class="items">
                        {% for it in g.items %}
                            <div class="item">
                                <span class="mname">{{ it.model }}</span>
                                <span class="chip">{{ 'Qty'|trans }} <b>{{ it.qty }}</b></span>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="cta">
                        {% if loggedIn %}
                            {% if g.chatUrl is not empty %}
                                <a class="chat" href="{{ g.chatUrl }}" target="_blank" rel="noopener">{{ 'Chat Now'|trans }}</a>
                            {% else %}
                                <span class="nowa">{{ 'No WhatsApp'|trans }}</span>
                            {% endif %}
                        {% else %}
                            <a class="chat" href="{{ path('_login_main') }}">{{ 'Chat Now'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    {% endif %}

    <footer class="foot">{{ 'Powered by Sunny'|trans }}</footer>
</div>
</body>
</html>
