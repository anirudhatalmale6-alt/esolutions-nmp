 #
 # Public, no-login Marketplace search - the home page. Self-contained (inline
 # CSS), text-only and mobile-first by design. Guests get a seller-hidden roll-up
 # and a prompt to log in; signed-in portal users see the business and a Chat Now
 # WhatsApp button per seller. Results are cards (not a table) so they read well
 # on a phone: the matched model(s) sit on top, a hairline divider, then the
 # seller row (display picture + business + location) and Chat.
 #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{{ 'Mobile Phones Wholesale & Distributors'|trans }}</title>
    <style>
        :root { --bg:#f7f8fa; --card:#ffffff; --ink:#20242c; --muted:#8b919b; --line:#e8eaef;
                --chip:#f2f3f6; --accent:#20242c; --accent-ink:#ffffff; --wa:#25d366; }
        * { box-sizing: border-box; }
        html, body { margin:0; overflow-x:hidden; }
        body { font-family: system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif; color:var(--ink); background:var(--bg); min-height:100vh; -webkit-text-size-adjust:100%; }
        .wrap { max-width: 680px; margin: 0 auto; padding: 16px 16px 64px; }
        .topbar { display:flex; justify-content:flex-end; align-items:center; gap:8px; min-height:26px; }
        .topbar a { text-decoration:none; }
        .authlink { color:var(--ink); font-weight:600; font-size:.9rem; padding:6px 14px; border:1px solid var(--line); border-radius:999px; background:var(--card); }
        .authlink.solid { background:var(--accent); color:var(--accent-ink); border-color:var(--accent); }
        .topbar .sep { color:var(--muted); }
        header.top { text-align:center; padding: 24px 0 6px; }
        /* Logo is the hero. The "Wholesale & Distributors" line is demoted to
           plain standard-size text (not a big heading) so the header stays neat
           - the tagline is already carried by the logo's slogan. */
        header.top h1 { margin:.2rem 0 0; white-space:normal; font-size:.95rem; font-weight:500; letter-spacing:0; color:var(--muted); }
        header.top p { margin:.35rem 0 0; color:var(--muted); font-size:.92rem; }
        /* B2B Network brand lockup at the top of the marketplace header. Two
           inline variants (base64) so it stays visible in both colour schemes:
           the dark lockup on the light theme, a light lockup in dark mode. */
        header.top .brandlogo { display:block; margin:0 auto; width:auto; height:clamp(60px, 16vw, 94px); max-width:100%; }
        header.top .brandlogo.light { display:none; }
        @media (prefers-color-scheme: dark) {
            header.top .brandlogo.dark { display:none; }
            header.top .brandlogo.light { display:block; }
        }
        form.search { display:flex; gap:8px; margin: 20px 0 6px; position: sticky; top: 10px; z-index:5; }
        form.search input[type=text] { flex:1; min-width:0; padding: 14px 18px; font-size:16px; border:1px solid var(--line); border-radius:12px; background:var(--card); color:var(--ink); outline:none; box-shadow:0 1px 2px rgba(0,0,0,.04); }
        form.search input[type=text]:focus { border-color:#c3c8d0; }
        form.search input::placeholder { color:#aab0ba; font-weight:400; }
        form.search button { padding: 0 20px; font-size:15px; font-weight:600; border:0; border-radius:12px; background:var(--accent); color:var(--accent-ink); cursor:pointer; }
        .count { color:var(--muted); font-size:.82rem; margin:16px 4px 8px; }

        .result { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin-top:10px; }

        /* Seller header on top: display picture (portal/company logo placeholder)
           + business/location. Text kept un-bold for a calm, minimal look. */
        .vendor { display:flex; align-items:center; gap:12px; }
        .dp { width:52px; height:52px; border-radius:50%; background:var(--chip); color:var(--ink); display:flex; align-items:center; justify-content:center; font-weight:500; font-size:1.25rem; flex:0 0 auto; overflow:hidden; }
        /* Logos sit on a white circle so a transparent or black-on-transparent
           logo never renders as a dark/empty disc (looks right in dark mode too),
           and "contain" shows the whole logo instead of cropping a wordmark. */
        img.dp { object-fit:contain; background:#ffffff; padding:4px; }
        .dp.generic { font-size:1.5rem; }
        .vinfo { flex:1 1 auto; min-width:0; }
        .vinfo .bname { font-weight:500; font-size:1rem; line-height:1.3; word-break:break-word; }
        .vinfo .loc { color:var(--muted); font-size:.85rem; margin-top:2px; }
        .vinfo .loc .flag { font-size:1rem; }
        /* Blue verified tick shown next to businesses the platform owner has
           approved - the visible payoff of account verification. */
        .vbadge { display:inline-flex; vertical-align:middle; margin-left:5px; position:relative; top:-1px; }
        .vbadge svg { width:16px; height:16px; display:block; }

        /* Light hairline running through the card. */
        .divider { height:1px; background:var(--line); margin:13px 0; }

        /* Matched model(s) with quantity. */
        .items { display:flex; flex-direction:column; gap:8px; }
        .item { display:flex; align-items:center; justify-content:space-between; gap:12px; }
        .item .mname { font-weight:500; font-size:1rem; line-height:1.3; word-break:break-word; text-align:left; }
        .chip { background:var(--chip); color:var(--ink); border-radius:999px; padding:5px 11px; font-size:.8rem; font-weight:500; white-space:nowrap; flex:0 0 auto; }
        .chip b { font-weight:600; }

        /* Chat action at the bottom of the card. */
        .cta { display:flex; justify-content:flex-end; margin-top:13px; }
        .chat { display:inline-flex; align-items:center; gap:6px; padding:11px 18px; background:var(--wa); color:#0a2e14; font-weight:600; text-decoration:none; border-radius:12px; font-size:.9rem; white-space:nowrap; }
        .nowa { color:var(--muted); font-size:.82rem; }

        .empty { text-align:center; color:var(--muted); background:var(--card); border:1px solid var(--line); border-radius:14px; padding: 30px 16px; margin-top:12px; }
        footer.foot { text-align:center; color:var(--muted); font-size:.8rem; margin-top:30px; }
        @media (max-width: 480px) {
            .cta { margin-top:12px; }
            .chat { width:100%; justify-content:center; }
        }
        @media (prefers-color-scheme: dark) {
            :root { --bg:#0f1216; --card:#171b22; --ink:#e8ebef; --muted:#98a2ad; --line:#272d37; --chip:#222831; --accent:#e9ecf1; --accent-ink:#12151a; }
            form.search input[type=text]:focus { border-color:#3a4150; }
        }

        /* ---- Paid classified adverts ------------------------------------
           An advert is a BANNER - wide artwork with writing already inside it.
           Two of those side by side on a phone gave each one about 170 pixels,
           which is narrower than the artwork's own headline needs, and the 4:3
           box then cropped the sides off. So: one per row on a phone, full
           width, and the whole picture shown rather than cropped to fit. Two
           across once there is room, four on a laptop where each one is still
           wide enough to read. */
        /* On a phone they swipe sideways rather than stacking. Four full-width
           banners one under the other is over a thousand pixels of advertising
           before the feed starts, which buries the thing people came back for.
           Sideways, each advert is still full size and the next one peeks in at
           the edge so it is obvious there are more. */
        .adsrow { display:flex; gap:12px; margin-top:18px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; scrollbar-width:none; padding-bottom:2px; }
        .adsrow::-webkit-scrollbar { display:none; }
        .ad { flex:0 0 86%; scroll-snap-align:start; display:block; background:var(--card); border:1px solid var(--line); border-radius:14px; overflow:hidden; text-decoration:none; color:inherit; }
        /* contain, never cover: whatever shape the advertiser uploaded is shown
           whole. A banner with its own text cannot afford to lose its edges, and
           the backdrop keeps the row tidy when shapes differ. */
        .ad img { display:block; width:100%; aspect-ratio:16/9; object-fit:contain; background:var(--chip); }
        /* The three lines are spans, because the whole card is a link and a link
           may not contain block-level markup. They are made to behave like lines
           here rather than running into one another. */
        .adbody { display:block; padding:12px 14px 14px; }
        .ad .adtitle { display:block; font-weight:600; font-size:1.02rem; line-height:1.3; word-break:break-word; }
        .ad .adcap { display:block; color:var(--muted); font-size:.88rem; margin-top:4px; line-height:1.4; }
        .ad .adby { display:block; color:var(--muted); font-size:.74rem; margin-top:7px; text-transform:uppercase; letter-spacing:.04em; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        /* Two across, never four. The page is a 680px reading column whatever
           the screen, so four in a row would be 160px each even on a laptop -
           the same unreadable banner, just on a bigger monitor. */
        @media (min-width: 620px) {
            .adsrow { display:grid; grid-template-columns:repeat(2, 1fr); overflow:visible; }
            .ad { flex:none; }
            .ad .adtitle { font-size:.95rem; }
            .ad .adcap { font-size:.82rem; }
        }

        /* ---- Community feed ---------------------------------------------
           Members posting stock, prices and warnings to each other. Small
           pictures on purpose - this is a trading noticeboard, not a photo
           album, and most of the people reading it are on mobile data. */
        .sechead { display:flex; align-items:baseline; justify-content:space-between; gap:10px; margin:26px 4px 10px; }
        .sechead h2 { margin:0; font-size:.95rem; font-weight:600; }
        /* The one-line explanation is there for somebody seeing the page for the
           first time. On a narrow phone it wraps onto two lines beside the
           heading and looks like a mistake, so it steps out of the way. */
        .sechead .hint { color:var(--muted); font-size:.78rem; text-align:right; }
        @media (max-width: 430px) { .sechead .hint { display:none; } }

        .post { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin-top:10px; }
        .phead { display:flex; align-items:center; gap:10px; }
        .pavatar { width:38px; height:38px; border-radius:50%; background:var(--chip); display:flex; align-items:center; justify-content:center; font-weight:600; font-size:1rem; flex:0 0 auto; }
        .pwho { flex:1 1 auto; min-width:0; }
        .pwho .pname { font-weight:600; font-size:.92rem; line-height:1.3; word-break:break-word; }
        .pwho .pwhen { color:var(--muted); font-size:.76rem; margin-top:1px; }
        .pbody { margin-top:10px; font-size:.94rem; line-height:1.5; white-space:pre-wrap; word-break:break-word; }
        /* Sized by how many there are. A single photo squeezed into a quarter of
           the card was what made these posts look empty - one gets a proper
           landscape frame, two share the row, three or four tile. Still small
           pictures: this is a trading board, not an album. */
        .pimgs { display:grid; grid-template-columns:repeat(4, 1fr); gap:6px; margin-top:11px; }
        .pimgs a { display:block; border-radius:10px; overflow:hidden; background:var(--chip); }
        .pimgs img { display:block; width:100%; aspect-ratio:1/1; object-fit:cover; background:var(--chip); }
        /* A lone picture is usually the whole point of the post - a banner, a
           price list, a photo of the boxes. It gets the full width of the card
           and keeps its own shape, capped so a tall one cannot run off the
           screen. Nothing is cropped: writing inside the picture has to survive.
           Several pictures still tile as squares, where cropping is fine. */
        .pimgs.n1 { grid-template-columns:1fr; }
        .pimgs.n1 img { aspect-ratio:auto; height:auto; max-height:420px; object-fit:contain; }
        .pimgs.n2 { grid-template-columns:repeat(2, 1fr); }
        .pimgs.n3 { grid-template-columns:repeat(3, 1fr); }
        .pfoot { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:10px; }
        .plink { background:none; border:0; padding:0; color:var(--muted); font-size:.78rem; cursor:pointer; font-family:inherit; }
        /* The reason to read the feed at all: whoever posted the stock is one
           tap away. Same green button as the search results, so it reads as the
           same action. */
        .pcta { display:flex; justify-content:flex-end; margin-top:12px; }
        .pcta .chat { padding:9px 16px; font-size:.86rem; }
        .pwhen .flag { font-size:.95rem; }

        .comments { margin-top:10px; border-top:1px solid var(--line); padding-top:10px; display:flex; flex-direction:column; gap:9px; }
        .comment { font-size:.88rem; line-height:1.45; word-break:break-word; }
        .comment .cwho { font-weight:600; }
        .comment .cwhen { color:var(--muted); font-size:.72rem; margin-left:6px; }

        /* The boxes for writing. Only drawn for signed-in members - a guest sees
           the feed and a line telling them what signing in gets them, which is
           the whole reason the feed is public in the first place. */
        .writer { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px 16px; margin-top:10px; }
        .writer textarea { width:100%; min-height:74px; resize:vertical; padding:11px 13px; font:inherit; font-size:.94rem; color:var(--ink); background:var(--bg); border:1px solid var(--line); border-radius:11px; outline:none; }
        .writer textarea:focus { border-color:#c3c8d0; }
        .wrow { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-top:11px; }
        /* The real file input is off-screen rather than display:none, so it can
           still be reached by keyboard and by a screen reader. */
        .wrow input[type=file] { position:absolute; width:1px; height:1px; opacity:0; pointer-events:none; }
        .wupload { display:inline-flex; align-items:center; gap:7px; padding:9px 14px; border:1px solid var(--line); border-radius:11px; background:var(--bg); color:var(--ink); font-size:.86rem; font-weight:600; cursor:pointer; }
        .wupload svg { width:17px; height:17px; display:block; flex:0 0 auto; }
        .wupload:hover { border-color:#c3c8d0; }
        .wbtn { padding:10px 20px; font-size:.9rem; font-weight:600; border:0; border-radius:11px; background:var(--accent); color:var(--accent-ink); cursor:pointer; }
        .replybox { display:flex; gap:8px; margin-top:10px; }
        .replybox input { flex:1; min-width:0; padding:9px 13px; font:inherit; font-size:.88rem; color:var(--ink); background:var(--bg); border:1px solid var(--line); border-radius:11px; outline:none; }
        .replybox input:focus { border-color:#c3c8d0; }
        .replybox button { padding:0 15px; font-size:.85rem; font-weight:600; border:0; border-radius:11px; background:var(--chip); color:var(--ink); cursor:pointer; }
        .joinline { text-align:center; color:var(--muted); font-size:.85rem; background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px; margin-top:10px; }
        .joinline a { color:var(--ink); font-weight:600; }
        .flash { border-radius:12px; padding:11px 14px; margin-top:12px; font-size:.88rem; }
        .flash.ok { background:#e7f7ec; color:#14622f; }
        .flash.err { background:#fdeceb; color:#8a1c14; }
        @media (prefers-color-scheme: dark) {
            .flash.ok { background:#12321f; color:#8fe0ab; }
            .flash.err { background:#3a1a18; color:#f3a49c; }
            .writer textarea:focus, .replybox input:focus { border-color:#3a4150; }
            .wupload:hover { border-color:#3a4150; }
        }
    </style>
</head>
<body>
<div class="wrap">
    {# The blue tick a verified business carries. Defined once, at page level:
       the search results and the community feed both draw it. #}
    {% set verifiedTick %}<span class="vbadge" title="{{ 'Verified business'|trans }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1d9bf0" d="M12 1.8l2.6 1.9 3.2-.2 1 3 2.6 1.8-1 3 1 3-2.6 1.8-1 3-3.2-.2L12 22.2l-2.6-1.9-3.2.2-1-3L2.6 15.7l1-3-1-3 2.6-1.8 1-3 3.2.2z"/><path fill="#fff" d="M10.6 14.6l-2.2-2.2-1.2 1.2 3.4 3.4 6-6-1.2-1.2z"/></svg></span>{% endset %}
    <div class="topbar">
        {% if loggedIn %}
            <a class="authlink solid" href="{{ path('_dashboard') }}">{{ 'My Portal'|trans }}</a>
        {% else %}
            <a class="authlink" href="{{ path('_register') }}">{{ 'Register'|trans }}</a>
            <span class="sep">|</span>
            <a class="authlink solid" href="{{ path('_login_main') }}">{{ 'Login'|trans }}</a>
        {% endif %}
    </div>

    <header class="top">
        <img class="brandlogo dark" src="{{ asset('images/b2b-logo-dark.png') }}" alt="B2B Network - Connecting Wholesalers">
        <img class="brandlogo light" src="{{ asset('images/b2b-logo-light.png') }}" alt="B2B Network - Connecting Wholesalers">
    </header>

    <form class="search" method="get" action="{{ path('_marketplace') }}" role="search">
        <input type="text" name="q" value="{{ query }}" placeholder="{{ 'Search a model, e.g. S26 Ultra'|trans }}"
               autocomplete="off" autocapitalize="none" autocorrect="off" enterkeyhint="search" aria-label="{{ 'Search a phone model'|trans }}" autofocus>
        <button type="submit">{{ 'Search'|trans }}</button>
    </form>

    {% if searched %}
        {% if results is empty %}
            <div class="empty">{{ 'No listed seller has "%q%" in stock right now.'|trans({'%q%': query}) }}</div>
        {% else %}
            <div class="count">{{ '%n% seller(s)'|trans({'%n%': results|length}) }}</div>
            {% for g in results %}
                {% set place = g.city ?: g.country %}
                <div class="result">
                    {# Seller header on top: display picture + business/location.
                       Guests never see the business name, so their display picture
                       stays generic - it must not leak the hidden initial. #}
                    <div class="vendor">
                        {% if loggedIn and g.business is not empty %}
                            {% if g.logo is not empty %}
                                <img class="dp" src="{{ g.logo }}" alt="{{ g.business }}">
                            {% else %}
                                <div class="dp">{{ g.business|trim|first|upper }}</div>
                            {% endif %}
                        {% else %}
                            <img class="dp" src="{{ asset('images/b2b-badge.png') }}" alt="B2B Network">
                        {% endif %}
                        <div class="vinfo">
                            {% if loggedIn and g.business is not empty %}
                                <div class="bname">{{ g.business }}{% if g.verified %}{{ verifiedTick }}{% endif %}</div>
                                {% if g.flag is not empty or place is not empty %}
                                    <div class="loc">{% if g.flag is not empty %}<span class="flag">{{ g.flag }}</span> {% endif %}{{ place }}</div>
                                {% endif %}
                            {% else %}
                                <div class="bname">{% if g.flag is not empty %}<span class="flag">{{ g.flag }}</span> {% endif %}{{ place ?: 'Verified seller'|trans }}{% if g.verified %}{{ verifiedTick }}{% endif %}</div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="divider"></div>

                    {# Matched model(s) with quantity. #}
                    <div class="items">
                        {% for it in g.items %}
                            <div class="item">
                                <span class="mname">{{ it.model }}</span>
                                <span class="chip">{{ 'Qty'|trans }} <b>{{ it.qty }}</b></span>
                            </div>
                        {% endfor %}
                    </div>

                    <div class="cta">
                        {% if loggedIn %}
                            {% if g.chatUrl is not empty %}
                                <a class="chat" href="{{ g.chatUrl }}" target="_blank" rel="noopener">{{ 'Chat Now'|trans }}</a>
                            {% else %}
                                <span class="nowa">{{ 'No WhatsApp'|trans }}</span>
                            {% endif %}
                        {% else %}
                            <a class="chat" href="{{ path('_login_main') }}">{{ 'Chat Now'|trans }}</a>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    {% endif %}

    {# Anything the last post or reply had to say. The page is standalone, so it
       renders its own flashes rather than inheriting an app layout's. #}
    {% for message in app.flashes('success') %}
        <div class="flash ok">{{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div class="flash err">{{ message }}</div>
    {% endfor %}

    {# ---- Paid classified adverts ----------------------------------------
       The four places the platform owner sells. Drawn only when there is
       something in them: four empty boxes on a new portal look broken, not
       available. #}
    {% if ads is not empty %}
        <div class="adsrow">
            {% for ad in ads %}
                {% set image = marketplace_media(ad.imagePath) %}
                {% if image %}
                    {% if ad.linkUrl %}
                        <a class="ad" href="{{ ad.linkUrl }}" target="_blank" rel="noopener nofollow">
                    {% else %}
                        <span class="ad">
                    {% endif %}
                        <img src="{{ image }}" alt="{{ ad.title }}" loading="lazy">
                        <span class="adbody">
                            <span class="adtitle">{{ ad.title }}</span>
                            {% if ad.caption %}<span class="adcap">{{ ad.caption }}</span>{% endif %}
                            {# The advertiser is named only to members, for the
                               same reason a seller is: a guest is meant to
                               register, not to walk away with the contact. #}
                            {% if loggedIn and ad.businessName %}<span class="adby">{{ ad.businessName }}</span>{% endif %}
                        </span>
                    {% if ad.linkUrl %}</a>{% else %}</span>{% endif %}
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}

    {# ---- Community feed -------------------------------------------------- #}
    <div class="sechead">
        <h2>{{ 'Community'|trans }}</h2>
        <span class="hint">{{ 'Stock, prices and warnings, from members'|trans }}</span>
    </div>

    {% if canPost %}
        <form class="writer" method="post" action="{{ path('_community_post') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('community.post') }}">
            <textarea name="body" maxlength="2000" placeholder="{{ 'What have you got? Stock, prices, what you are looking for...'|trans }}"></textarea>
            {# The browser's own file input is three different widgets depending
               on the browser, and on a phone it wrapped onto its own line and
               pushed Post underneath it. Hidden, with a label acting as the
               button, so the row is always "add photos" on the left and "Post"
               on the right. #}
            <div class="wrow">
                <label class="wupload" for="post-images">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 5h3l1.5-2h7L17 5h3a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm8 4a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 2a3 3 0 1 1 0 6 3 3 0 0 1 0-6Z"/></svg>
                    <span class="wupload-label">{{ 'Add photos'|trans }}</span>
                </label>
                <input type="file" id="post-images" name="images[]" accept=".jpg,.jpeg,.png,.webp" multiple>
                <button type="submit" class="wbtn">{{ 'Post'|trans }}</button>
            </div>
        </form>
    {% elseif not loggedIn %}
        <div class="joinline">
            {{ 'Members post their stock here.'|trans }}
            <a href="{{ path('_login_main') }}">{{ 'Log in'|trans }}</a>
            {{ 'or'|trans }}
            <a href="{{ path('_register') }}">{{ 'register'|trans }}</a>
            {{ 'to join in.'|trans }}
        </div>
    {% endif %}

    {% if feed is empty %}
        <div class="empty">{{ 'Nothing posted yet.'|trans }}</div>
    {% else %}
        {% for entry in feed %}
            {% set post = entry.post %}
            {# A guest sees what was said but not who said it - the same rule the
               search results follow, and the reason a buyer signs up. #}
            {% set who = loggedIn ? (post.businessName ?: post.authorName ?: 'Member'|trans) : 'B2B Member'|trans %}
            {% set place = loggedIn ? entry.location : '' %}
            <div class="post">
                <div class="phead">
                    <div class="pavatar">{{ who|trim|first|upper }}</div>
                    <div class="pwho">
                        <div class="pname">
                            {{ who }}
                            {# The blue tick a business earns by sending in its
                               documents - the same one the search results show.
                               Hidden from guests along with the name it sits
                               beside, or it would say which business this is. #}
                            {% if loggedIn and entry.verified %}{{ verifiedTick }}{% endif %}
                        </div>
                        <div class="pwhen">
                            {% if place %}<span class="flag">{{ entry.flag }}</span> {{ place }} &middot; {% endif %}
                            {{ post.created ? post.created|date('j M, H:i') : '' }}
                        </div>
                    </div>
                </div>

                {% if post.body %}<div class="pbody">{{ post.body }}</div>{% endif %}

                {% if post.images is not empty %}
                    {# One picture gets the width it deserves; several share the
                       row. A lone photo squeezed into a quarter of the card was
                       what made these posts look empty. #}
                    <div class="pimgs n{{ post.images|length }}">
                        {% for image in post.images %}
                            {% set url = marketplace_media(image) %}
                            {% if url %}
                                <a href="{{ url }}" target="_blank" rel="noopener">
                                    <img src="{{ url }}" alt="" loading="lazy">
                                </a>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                {# The whole point of somebody posting stock is that you can reach
                   them. Signed-in only, and only for a business that put its
                   number on the Marketplace itself. #}
                {% if loggedIn and entry.chatUrl %}
                    <div class="pcta">
                        <a class="chat" href="{{ entry.chatUrl }}" target="_blank" rel="noopener">{{ 'Chat Now'|trans }}</a>
                    </div>
                {% endif %}

                {% if entry.comments is not empty %}
                    <div class="comments">
                        {% for comment in entry.comments %}
                            {% set cwho = loggedIn ? (comment.businessName ?: comment.authorName ?: 'Member'|trans) : 'B2B Member'|trans %}
                            <div class="comment">
                                <span class="cwho">{{ cwho }}</span>
                                <span class="cwhen">{{ comment.created ? comment.created|date('j M, H:i') : '' }}</span>
                                <div>{{ comment.body }}</div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}

                {% if canPost %}
                    <form class="replybox" method="post" action="{{ path('_community_reply', {id: post.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('community.reply') }}">
                        <input type="text" name="body" maxlength="1000" placeholder="{{ 'Reply'|trans }}" aria-label="{{ 'Reply'|trans }}">
                        <button type="submit">{{ 'Send'|trans }}</button>
                    </form>
                {% endif %}

                {# Only the business that wrote it and the platform owner. #}
                {% if entry.canRemove %}
                    <div class="pfoot">
                        <span></span>
                        <form method="post" action="{{ path('_community_remove', {id: post.id}) }}"
                              onsubmit="return confirm('{{ 'Remove this post?'|trans|e('js') }}');">
                            <input type="hidden" name="_token" value="{{ csrf_token('community.remove') }}">
                            <button type="submit" class="plink">{{ 'Remove'|trans }}</button>
                        </form>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    {% endif %}

    <footer class="foot">{{ 'Powered by Sunny'|trans }}</footer>
</div>

{# The only script on the page: say how many photos were picked. Without it the
   member taps Add photos, chooses three, and the button looks exactly as it did
   before - so they tap it again, or post with nothing attached. #}
<script>
    (function () {
        var input = document.getElementById('post-images');

        if (!input) { return; }

        var label = document.querySelector('.wupload-label');

        if (!label) { return; }

        var idle = label.textContent;

        input.addEventListener('change', function () {
            var n = input.files ? input.files.length : 0;

            label.textContent = n === 0 ? idle : (n === 1 ? '1 photo' : n + ' photos');
        });
    })();
</script>
</body>
</html>
