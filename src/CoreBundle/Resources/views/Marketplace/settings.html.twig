{# Standalone Marketplace page (reached via sidebar Marketplace > Share My
   Inventory) - uses the plain content layout, not the profile-settings layout,
   so the account-settings side nav (Profile, Change Password, ...) is not shown
   here where it isn't relevant. #}
{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:building-store', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Stock Listing'|trans }}{% endblock title %}

{% block heading %}
    <a href="{{ path('_marketplace') }}" target="_blank" rel="noopener" class="btn btn-outline-secondary">
        {{ ux_icon('tabler:external-link', {width: 18, height: 18}) }}
        {{ 'Open Marketplace'|trans }}
    </a>
{% endblock %}

{% block content %}
    <twig:Ui:Card>
        <h3 class="mb-1">{{ 'Marketplace'|trans }}</h3>
        <p class="text-secondary">
            {{ 'The Marketplace lets buyers search phone models across sellers. Turn this on to list your Tally stock so buyers can find it and reach you on WhatsApp. Turn it off any time and your stock disappears from search. Prices are never shown - buyers message you for details.'|trans }}
        </p>

        <form method="post" action="{{ path('_marketplace_settings') }}" enctype="multipart/form-data">
            <input type="hidden" name="_token" value="{{ csrf_token('marketplace.settings') }}">

            <label class="form-check form-switch mb-4">
                <input class="form-check-input" type="checkbox" name="listed" value="1"{{ listed ? ' checked' : '' }}>
                <span class="form-check-label fw-semibold">{{ 'List my stock on the Marketplace'|trans }}</span>
            </label>

            <div class="mb-4" style="max-width: 620px;">
                <label for="logo" class="form-label">{{ 'Listing logo (display picture)'|trans }}</label>
                <div class="d-flex align-items-center gap-3">
                    {% if logo is not empty %}
                        <img src="{{ logo }}" alt="{{ 'Current listing logo'|trans }}" width="56" height="56" style="width:56px;height:56px;border-radius:50%;object-fit:cover;border:1px solid var(--bs-border-color);">
                    {% endif %}
                    <div class="flex-grow-1">
                        <input type="file" name="logo" id="logo" class="form-control" accept="image/jpeg,image/png,image/gif,image/webp">
                    </div>
                </div>
                <small class="text-secondary d-block mt-1">{{ 'Shown next to your business in search results. A colour image works best (JPEG, PNG, GIF or WebP, under 1.5 MB). This is separate from your invoice logo. If you leave it blank, your company logo is used.'|trans }}</small>
                {% if logo is not empty %}
                    <label class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" name="remove_logo" value="1">
                        <span class="form-check-label">{{ 'Remove current listing logo'|trans }}</span>
                    </label>
                {% endif %}
            </div>

            <div class="mb-3" style="max-width: 420px;">
                <label for="whatsapp" class="form-label">{{ 'WhatsApp number for buyers'|trans }}</label>
                <input type="text" name="whatsapp" id="whatsapp" class="form-control" value="{{ whatsapp }}" placeholder="{{ 'e.g. 9715XXXXXXXX'|trans }}" autocomplete="off">
                <small class="text-secondary">{{ 'Include the country code, digits only (no +, spaces or dashes). Leave blank to hide the Chat Now button.'|trans }}</small>
            </div>

            <div class="row g-3 mb-3" style="max-width: 620px;">
                <div class="col-md-6">
                    <label for="country" class="form-label">{{ 'Country'|trans }}</label>
                    <select name="country" id="country" class="form-select">
                        <option value="">{{ '- Select -'|trans }}</option>
                        {% for c in countries %}
                            <option value="{{ c.code }}"{{ c.code == country ? ' selected' : '' }}>{{ c.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-6">
                    <label for="city" class="form-label">{{ 'City'|trans }}</label>
                    <input type="text" name="city" id="city" class="form-control" value="{{ city }}" placeholder="{{ 'e.g. Dubai'|trans }}" autocomplete="off">
                </div>
                <div class="col-12">
                    <small class="text-secondary">{{ 'Shown to buyers in search results (with a flag) so they know where you are.'|trans }}</small>
                </div>
            </div>

            <hr class="my-4">

            {# The second, separate channel: the business's own no-login link. It
               shares this form (and this Save button) so a business sets up how
               its stock is seen in one place. #}
            <h3 class="mb-1">{{ 'My own stock page'|trans }}</h3>
            <p class="text-secondary">
                {{ 'A page of your own stock that you send to your customers - no login needed, and no prices, only model, grade and quantity. Turn it off and the link stops working straight away.'|trans }}
            </p>

            <label class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" name="share_stock" value="1"{{ shareStock|default(false) ? ' checked' : '' }}>
                <span class="form-check-label fw-semibold">{{ 'Publish my own stock page'|trans }}</span>
            </label>

            <div class="mb-3" style="max-width: 620px;">
                <label for="share_slug" class="form-label">{{ 'Page address'|trans }}</label>
                <div class="input-group">
                    <span class="input-group-text text-truncate" style="max-width: 320px;">{{ shareBase|default('') }}</span>
                    <input type="text" name="share_slug" id="share_slug" class="form-control" value="{{ shareSlug|default('') }}" placeholder="{{ 'e.g. my-shop'|trans }}" autocomplete="off">
                </div>
                <small class="text-secondary">{{ 'Letters, numbers and dashes only. Pick something short your customers will recognise - it is part of the link you send them.'|trans }}</small>
            </div>

            {% if shareUrl|default('') is not empty %}
                <div class="mb-4" style="max-width: 620px;">
                    <label for="stock-share-url" class="form-label">{{ 'Your live link'|trans }}</label>
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <input type="text" id="stock-share-url" class="form-control" style="max-width: 420px;" value="{{ shareUrl }}" readonly onclick="this.select()">
                        <button type="button" id="stock-share-copy" class="btn btn-outline-primary">{{ 'Copy'|trans }}</button>
                        <a href="{{ shareUrl }}" target="_blank" rel="noopener" class="btn btn-link">{{ 'Open'|trans }}</a>
                    </div>
                </div>
            {% endif %}

            <button type="submit" class="btn btn-primary">
                {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                {{ 'Save'|trans }}
            </button>
        </form>
    </twig:Ui:Card>

    {% if shareUrl|default('') is not empty %}
        <script>
            (function () {
                var btn = document.getElementById('stock-share-copy');
                var field = document.getElementById('stock-share-url');
                if (!btn || !field) { return; }
                btn.addEventListener('click', function () {
                    field.select();
                    var done = function () {
                        var original = btn.innerHTML;
                        btn.innerHTML = {{ 'Copied!'|trans|json_encode|raw }};
                        setTimeout(function () { btn.innerHTML = original; }, 1500);
                    };
                    if (navigator.clipboard && navigator.clipboard.writeText) {
                        navigator.clipboard.writeText(field.value).then(done, function () { document.execCommand('copy'); done(); });
                    } else {
                        document.execCommand('copy');
                        done();
                    }
                });
            })();
        </script>
    {% endif %}
{% endblock content %}
