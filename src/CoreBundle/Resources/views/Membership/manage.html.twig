{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:crown', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Memberships'|trans }}{% endblock title %}

{% block content %}
    <twig:Ui:Card>
        <p class="text-secondary">
            {{ 'Every company on the portal. New sign-ups appear here as "Not verified" - tick Verified to approve them into the portal. A company with No plan cannot use anything until you put it on Basic or Premium (or later, they pay). Basic gives invoicing and internal tools; Premium also unlocks the Marketplace and Online Store. You can also grant a plan complimentary (free). Under Account you can reset any account\'s password, or delete a company and its account - handy for clearing duplicate or test sign-ups (your own company can\'t be deleted here).'|trans }}
        </p>

        <div class="table-responsive">
            <table class="table table-vcenter">
                <thead>
                    <tr>
                        <th>{{ 'Company'|trans }}</th>
                        <th>{{ 'Current status'|trans }}</th>
                        <th style="min-width: 360px;">{{ 'Set membership'|trans }}</th>
                        <th style="min-width: 240px;">{{ 'Account'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set isLifetime = row.plan.isPaid and row.expiresAt is null %}
                        <tr>
                            <td>
                                <div class="fw-bold">{{ row.company.name }}</div>
                                {% if row.verified %}
                                    <span class="badge bg-green-lt">{{ ux_icon('tabler:rosette-discount-check', {width: 14, height: 14, class: 'me-1'}) }}{{ 'Verified'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt">{{ 'Not verified'|trans }}</span>
                                {% endif %}
                            </td>

                            <td>
                                {% if row.plan.value == 'premium' %}
                                    <span class="badge bg-yellow-lt">{{ ux_icon('tabler:crown', {width: 14, height: 14, class: 'me-1'}) }}{{ 'Premium'|trans }}</span>
                                {% elseif row.plan.value == 'basic' %}
                                    <span class="badge bg-blue-lt">{{ 'Basic'|trans }}</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt">{{ 'No plan'|trans }}</span>
                                {% endif %}

                                {% if row.plan.isPaid %}
                                    {% if not row.active %}
                                        <span class="badge bg-red-lt ms-1">{{ 'Lapsed'|trans }}</span>
                                    {% endif %}
                                    {% if row.complimentary %}
                                        <span class="badge bg-purple-lt ms-1">{{ 'Complimentary'|trans }}</span>
                                    {% endif %}
                                    <div class="small text-secondary mt-1">
                                        {% if row.expiresAt is null %}
                                            {{ 'No expiry'|trans }}
                                        {% else %}
                                            {{ 'Expires'|trans }}: {{ row.expiresAt|date('d M Y') }}
                                        {% endif %}
                                    </div>
                                {% endif %}
                            </td>

                            <td>
                                <form method="post" action="{{ path('_membership_manage') }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('membership.manage') }}">
                                    <input type="hidden" name="company" value="{{ row.company.id }}">
                                    <div class="row g-2 align-items-center">
                                        <div class="col-auto">
                                            <select name="plan" class="form-select form-select-sm">
                                                {% for plan in plans %}
                                                    <option value="{{ plan.value }}"{{ row.plan.value == plan.value ? ' selected' }}>{{ plan.label|trans }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>
                                        <div class="col-auto">
                                            <select name="term" class="form-select form-select-sm" title="{{ 'Term (only applies to a paid plan)'|trans }}">
                                                <option value="annual"{{ not isLifetime ? ' selected' }}>{{ 'Annual (1 year)'|trans }}</option>
                                                <option value="lifetime"{{ isLifetime ? ' selected' }}>{{ 'Lifetime (no expiry)'|trans }}</option>
                                            </select>
                                        </div>
                                        <div class="col-auto">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                {{ ux_icon('tabler:device-floppy', {width: 16, height: 16}) }}
                                                {{ 'Save'|trans }}
                                            </button>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" name="verified" value="1"{{ row.verified ? ' checked' }}>
                                                <span class="form-check-label">{{ 'Verified'|trans }}</span>
                                            </label>
                                            <label class="form-check form-check-inline">
                                                <input class="form-check-input" type="checkbox" name="complimentary" value="1"{{ row.complimentary ? ' checked' }}>
                                                <span class="form-check-label">{{ 'Complimentary (free)'|trans }}</span>
                                            </label>
                                        </div>
                                    </div>
                                </form>
                            </td>

                            <td>
                                {% for u in row.users %}
                                    <div class="mb-2">
                                        <div class="small fw-bold text-truncate" style="max-width: 230px;" title="{{ u.email }}">{{ u.email }}</div>
                                        <form method="post" action="{{ path('_membership_manage') }}" class="d-flex gap-1 mt-1">
                                            <input type="hidden" name="_token" value="{{ csrf_token('membership.manage') }}">
                                            <input type="hidden" name="intent" value="reset_password">
                                            <input type="hidden" name="email" value="{{ u.email }}">
                                            <input type="password" name="password" class="form-control form-control-sm" placeholder="{{ 'New password'|trans }}" minlength="6" required style="max-width: 150px;">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" title="{{ 'Set a new password for this account'|trans }}">{{ 'Set'|trans }}</button>
                                        </form>
                                    </div>
                                {% else %}
                                    <div class="small text-secondary">{{ 'No account'|trans }}</div>
                                {% endfor %}

                                {% if row.canDelete %}
                                    <form method="post" action="{{ path('_membership_manage') }}" class="mt-2"
                                          onsubmit="return confirm('{{ 'Delete %name% and its account(s)? This cannot be undone.'|trans({'%name%': row.company.name})|e('js') }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('membership.manage') }}">
                                        <input type="hidden" name="intent" value="delete_company">
                                        <input type="hidden" name="company" value="{{ row.company.id }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            {{ ux_icon('tabler:trash', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Delete'|trans }}
                                        </button>
                                    </form>
                                {% else %}
                                    <div class="small text-secondary mt-2">{{ ux_icon('tabler:lock', {width: 14, height: 14, class: 'me-1'}) }}{{ 'Your company'|trans }}</div>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="4" class="text-center text-secondary py-4">{{ 'No companies yet.'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </twig:Ui:Card>
{% endblock content %}
