{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:crown', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Memberships'|trans }}{% endblock title %}

{% block content %}
    {# This theme's "secondary" brand colour is an amber/gold (#f0a015), so the muted
       text and light chips built with text-secondary / bg-secondary-lt came out as a
       blurry light-orange. Recolour them to the crisp slate greys used elsewhere in
       the app. Scoped to this page only - it only exists in the DOM while this page
       is open, so no other screen is affected. #}
    <style>
        .nmp-console .text-secondary { color: #64748b !important; }
        .nmp-console thead th { color: #64748b !important; }
        .nmp-console .bg-secondary-lt { background-color: #f1f5f9 !important; color: #475569 !important; }
        /* Verified = the blue scalloped seal + white tick, same mark as the marketplace. */
        .nmp-console .vtick { display: inline-flex; vertical-align: middle; margin-left: 5px; position: relative; top: -1px; }
        .nmp-console .vtick svg { width: 16px; height: 16px; display: block; }
    </style>
    {% set verifiedTick %}<span class="vtick" title="{{ 'Verified business'|trans }}"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#1d9bf0" d="M12 1.8l2.6 1.9 3.2-.2 1 3 2.6 1.8-1 3 1 3-2.6 1.8-1 3-3.2-.2L12 22.2l-2.6-1.9-3.2.2-1-3L2.6 15.7l1-3-1-3 2.6-1.8 1-3 3.2.2z"/><path fill="#fff" d="M10.6 14.6l-2.2-2.2-1.2 1.2 3.4 3.4 6-6-1.2-1.2z"/></svg></span>{% endset %}
    <div class="nmp-console">
    <twig:Ui:Card>
        <p class="text-secondary">
            {{ 'Every company on the portal, one per line. Search by business name or e-mail, then click Manage to set its plan, verify it, reset a password or remove it. A company on No plan cannot use anything until you put it on Basic or Premium. Basic gives invoicing and internal tools; Premium also unlocks the Marketplace and Online Store.'|trans }}
        </p>

        <div class="mb-3">
            <div class="input-group" style="max-width: 420px;">
                <span class="input-group-text">{{ ux_icon('tabler:search', {width: 16, height: 16}) }}</span>
                <input type="text" id="memberSearch" class="form-control" placeholder="{{ 'Search business or e-mail…'|trans }}" autocomplete="off">
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter card-table" id="memberTable">
                <thead>
                    <tr>
                        <th>{{ 'Business'|trans }}</th>
                        <th>{{ 'E-mail'|trans }}</th>
                        <th>{{ 'Plan'|trans }}</th>
                        <th>{{ 'Status'|trans }}</th>
                        <th>{{ 'Accounts'|trans }}</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {% set primaryUser = row.users|first %}
                        {% set haystack = row.company.name %}
                        {% for u in row.users %}{% set haystack = haystack ~ ' ' ~ u.email %}{% endfor %}
                        <tr data-search="{{ haystack|lower }}">
                            <td>
                                <div class="d-flex align-items-center">
                                    <span class="avatar avatar-sm me-2 rounded bg-secondary-lt">{{ row.company.name|slice(0, 1)|upper }}</span>
                                    <div>
                                        <div class="fw-bold">{{ row.company.name }}{% if row.verified %}{{ verifiedTick }}{% endif %}</div>
                                        {% if not row.verified %}
                                            <span class="text-secondary small">{{ 'Not verified'|trans }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </td>

                            <td>
                                {% if primaryUser %}
                                    <span class="text-secondary">{{ primaryUser.email }}</span>
                                    {% if row.users|length > 1 %}
                                        <span class="badge bg-secondary-lt ms-1">+{{ row.users|length - 1 }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-secondary small">—</span>
                                {% endif %}
                            </td>

                            <td>
                                {% if row.plan.value == 'premium' %}
                                    <span class="badge bg-secondary-lt">{{ ux_icon('tabler:crown', {width: 13, height: 13, class: 'me-1'}) }}{{ 'Premium'|trans }}</span>
                                {% elseif row.plan.value == 'basic' %}
                                    <span class="badge bg-secondary-lt">{{ 'Basic'|trans }}</span>
                                {% else %}
                                    <span class="text-secondary small">{{ 'No plan'|trans }}</span>
                                {% endif %}
                                {% if row.complimentary %}
                                    <span class="text-secondary small ms-1">· {{ 'Free'|trans }}</span>
                                {% endif %}
                                {# Only the hand-given grant is flagged here - Premium
                                   already says it on the badge beside it. #}
                                {% if row.marketplaceGranted %}
                                    <span class="badge bg-secondary-lt ms-1" title="{{ 'Marketplace enabled for this business without Premium'|trans }}">{{ ux_icon('tabler:building-store', {width: 13, height: 13, class: 'me-1'}) }}{{ 'Marketplace'|trans }}</span>
                                {% endif %}
                            </td>

                            <td>
                                {% if row.plan.isPaid %}
                                    {% if not row.active %}
                                        <span class="text-danger small">{{ 'Lapsed'|trans }}</span>
                                    {% elseif row.expiresAt is null %}
                                        <span class="text-secondary small">{{ 'No expiry'|trans }}</span>
                                    {% else %}
                                        <span class="text-secondary small">{{ 'Expires'|trans }} {{ row.expiresAt|date('d M Y') }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="text-secondary small">—</span>
                                {% endif %}
                            </td>

                            <td>
                                <span class="text-secondary">{{ row.users|length }}</span>
                            </td>

                            <td>
                                <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#manage-{{ row.company.id }}">
                                    {{ ux_icon('tabler:settings', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Manage'|trans }}
                                </button>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">{{ 'No companies yet.'|trans }}</td>
                        </tr>
                    {% endfor %}
                    <tr id="memberNoMatch" style="display: none;">
                        <td colspan="6" class="text-center text-secondary py-4">{{ 'No business matches your search.'|trans }}</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </twig:Ui:Card>

    {# One modal per company - all the controls, nicely grouped. #}
    {% for row in rows %}
        {% set isLifetime = row.plan.isPaid and row.expiresAt is null %}
        {% set primaryUser = row.users|first %}
        <twig:Ui:Modal id="manage-{{ row.company.id }}" size="lg" centered>
            <twig:block name="header">
                <h5 class="modal-title">
                    {{ ux_icon('tabler:building-store', {width: 20, height: 20, class: 'me-2'}) }}{{ row.company.name }}{% if row.verified %}{{ verifiedTick }}{% endif %}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </twig:block>

            {# --- Profile --- #}
            <h4 class="mb-2">{{ ux_icon('tabler:id-badge-2', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Profile'|trans }}</h4>
            <div class="row g-3 mb-1">
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'Business name'|trans }}</div>
                    <div class="fw-bold">{{ row.company.name }}</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'Contact e-mail'|trans }}</div>
                    <div class="fw-bold">
                        {% if primaryUser %}
                            <a href="mailto:{{ primaryUser.email }}">{{ primaryUser.email }}</a>
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'All accounts'|trans }} ({{ row.users|length }})</div>
                    <div class="fw-bold">
                        {% if row.users|length > 0 %}
                            {% for u in row.users %}
                                <div><a href="mailto:{{ u.email }}">{{ u.email }}</a></div>
                            {% endfor %}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'Contact person'|trans }}</div>
                    <div class="fw-bold">
                        {% if primaryUser and (primaryUser.firstName or primaryUser.lastName) %}
                            {{ (primaryUser.firstName ~ ' ' ~ primaryUser.lastName)|trim }}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'Contact number'|trans }}</div>
                    <div class="fw-bold">
                        {% if row.company.contactNumber %}
                            {{ row.company.contactNumber }}
                            {% if row.company.contactVerified %}
                                <span class="text-success ms-1" title="{{ 'Number confirmed'|trans }}">{{ ux_icon('tabler:circle-check', {width: 14, height: 14}) }}</span>
                            {% else %}
                                <span class="text-secondary small ms-1">({{ 'not confirmed'|trans }})</span>
                            {% endif %}
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'Based in'|trans }}</div>
                    <div class="fw-bold">{{ row.location ?: '—' }}</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'Custom domain'|trans }}</div>
                    <div class="fw-bold">{{ row.company.customDomain ?: '—' }}</div>
                </div>
                <div class="col-sm-6">
                    <div class="text-secondary small">{{ 'Referred by'|trans }}</div>
                    <div class="fw-bold">
                        {% if row.company.referredByName %}
                            {{ ux_icon('tabler:users-group', {width: 14, height: 14, class: 'me-1'}) }}{{ row.company.referredByName }}
                            <span class="text-secondary small">({{ row.company.referredByCode }})</span>
                        {% else %}
                            —
                        {% endif %}
                    </div>
                </div>
            </div>

            <hr class="my-4">

            {# --- Identity documents ---
               What the Verified tick below is actually a judgement about. It used
               to be ticked with nothing but a name and an email address on screen. #}
            <h4 class="mb-2">
                {{ ux_icon('tabler:id-badge-2', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Identity documents'|trans }}
                {% if row.company.awaitingVerification %}
                    <span class="badge bg-info-lt ms-1">{{ 'Waiting for review'|trans }}</span>
                {% endif %}
            </h4>
            {% if row.documents|length > 0 %}
                <p class="text-secondary small mb-2">
                    {% if row.company.verificationSubmittedAt %}
                        {{ 'Sent on'|trans }} {{ row.company.verificationSubmittedAt|date('j M Y, H:i') }}.
                    {% endif %}
                    {{ 'Opens in a new tab. Only you can see these.'|trans }}
                </p>
                <div class="d-flex flex-wrap gap-2 mb-2">
                    {% for document in row.documents %}
                        <a class="btn btn-outline-secondary btn-sm"
                           href="{{ path('_verification_document', {company: row.company.id, kind: document.kind}) }}"
                           target="_blank" rel="noopener">
                            {{ ux_icon('tabler:file-text', {width: 14, height: 14, class: 'me-1'}) }}{{ document.label|trans }}
                        </a>
                    {% endfor %}
                </div>
            {% else %}
                <p class="text-secondary small mb-2">
                    {{ 'Nothing sent in yet. Getting verified is optional, so a business can be trading here without it.'|trans }}
                </p>
            {% endif %}

            <hr class="my-4">

            {# --- Membership --- #}
            <h4 class="mb-2">{{ ux_icon('tabler:crown', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Membership'|trans }}</h4>
            <form method="post" action="{{ path('_membership_manage') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('membership.manage') }}">
                <input type="hidden" name="intent" value="save">
                <input type="hidden" name="company" value="{{ row.company.id }}">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">{{ 'Plan'|trans }}</label>
                        <select name="plan" class="form-select">
                            {% for plan in plans %}
                                <option value="{{ plan.value }}"{{ row.plan.value == plan.value ? ' selected' }}>{{ plan.label|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">{{ 'Term'|trans }}</label>
                        <select name="term" class="form-select" title="{{ 'Only applies to a paid plan'|trans }}">
                            <option value="annual"{{ not isLifetime ? ' selected' }}>{{ 'Annual (1 year)'|trans }}</option>
                            <option value="lifetime"{{ isLifetime ? ' selected' }}>{{ 'Lifetime (no expiry)'|trans }}</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="verified" value="1"{{ row.verified ? ' checked' }}>
                            <span class="form-check-label">{{ 'Verified'|trans }} <span class="text-secondary">— {{ 'required before Premium can be set'|trans }}</span></span>
                        </label>
                        {# A plain fact about one phone number, kept apart from the
                           badge above it. Ticked after somebody has actually
                           reached them - today that is a WhatsApp message and a
                           reply, which costs nothing and is more convincing than
                           an automated code. #}
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="contact_verified" value="1"{{ row.contactVerified ? ' checked' }}>
                            <span class="form-check-label">
                                {{ 'Number confirmed'|trans }}
                                <span class="text-secondary">— {{ 'we have reached them on'|trans }} {{ row.company.contactNumber ?: 'no number given'|trans }}</span>
                            </span>
                        </label>
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="complimentary" value="1"{{ row.complimentary ? ' checked' }}>
                            <span class="form-check-label">{{ 'Complimentary (free)'|trans }} <span class="text-secondary">— {{ 'no charge'|trans }}</span></span>
                        </label>
                        {# Independent of the plan on purpose: this is how a business
                           is let into the Marketplace without being moved to Premium. #}
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="marketplace_access" value="1"{{ row.marketplaceGranted ? ' checked' }}>
                            <span class="form-check-label">
                                {{ 'Marketplace'|trans }}
                                <span class="text-secondary">— {{ 'let this business list its stock, no Premium needed'|trans }}</span>
                                {% if row.marketplaceAccess and not row.marketplaceGranted %}
                                    <span class="text-secondary">({{ 'already has it through Premium'|trans }})</span>
                                {% endif %}
                            </span>
                        </label>
                        {# Off by default. Turning it on is the moment this business
                           stops getting its quantities from Tally and starts
                           counting for itself. #}
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="live_stock" value="1"{{ row.liveStock ? ' checked' }}>
                            <span class="form-check-label">
                                {{ 'Live stock'|trans }}
                                <span class="text-secondary">— {{ 'invoices take stock out and purchases put it in, instead of quantities coming from Tally'|trans }}</span>
                            </span>
                        </label>
                        {# Sold by the place, not by the plan. Switching it off
                           leaves whatever they wrote alone - the advert simply
                           stops being drawn, so paying again next month puts it
                           straight back. #}
                        <label class="form-check">
                            <input class="form-check-input" type="checkbox" name="classifieds_access" value="1"{{ row.classifiedsAccess ? ' checked' }}>
                            <span class="form-check-label">
                                {{ 'Classified advert'|trans }}
                                <span class="text-secondary">— {{ 'this business may run a paid advert on the Marketplace; you still decide which of the four places it gets'|trans }}</span>
                            </span>
                        </label>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary">
                            {{ ux_icon('tabler:device-floppy', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Save membership'|trans }}
                        </button>
                    </div>
                </div>
            </form>

            <hr class="my-4">

            {# --- Accounts --- #}
            <h4 class="mb-2">{{ ux_icon('tabler:key', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Reset a password'|trans }}</h4>
            {% if row.users|length > 0 %}
                <form method="post" action="{{ path('_membership_manage') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('membership.manage') }}">
                    <input type="hidden" name="intent" value="reset_password">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label">{{ 'Account'|trans }}</label>
                            <select name="email" class="form-select">
                                {% for u in row.users %}
                                    <option value="{{ u.email }}">{{ u.email }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">{{ 'New password'|trans }}</label>
                            <input type="password" name="password" class="form-control" placeholder="{{ 'Min 6 characters'|trans }}" minlength="6" required>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-outline-primary w-100">{{ 'Reset'|trans }}</button>
                        </div>
                    </div>
                </form>
            {% else %}
                <div class="text-secondary small">{{ 'No account linked to this company.'|trans }}</div>
            {% endif %}

            {% if row.canDelete %}
                <hr class="my-4">
                <h4 class="mb-2 text-danger">{{ ux_icon('tabler:alert-triangle', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Danger zone'|trans }}</h4>
                <p class="text-secondary small mb-2">{{ 'Permanently delete this company and any account that belongs only to it. Handy for clearing duplicate or test sign-ups.'|trans }}</p>
                <form method="post" action="{{ path('_membership_manage') }}"
                      onsubmit="return confirm('{{ 'Delete %name% and its account(s)? This cannot be undone.'|trans({'%name%': row.company.name})|e('js') }}');">
                    <input type="hidden" name="_token" value="{{ csrf_token('membership.manage') }}">
                    <input type="hidden" name="intent" value="delete_company">
                    <input type="hidden" name="company" value="{{ row.company.id }}">
                    <button type="submit" class="btn btn-outline-danger">
                        {{ ux_icon('tabler:trash', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Delete company'|trans }}
                    </button>
                </form>
            {% else %}
                <hr class="my-4">
                <div class="text-secondary small">{{ ux_icon('tabler:lock', {width: 14, height: 14, class: 'me-1'}) }}{{ 'This is your own company, so it can\'t be deleted here.'|trans }}</div>
            {% endif %}

            <twig:block name="footer">
                <button type="button" class="btn" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
            </twig:block>
        </twig:Ui:Modal>
    {% endfor %}

    <script>
        (function () {
            var input = document.getElementById('memberSearch');
            if (!input) { return; }
            var table = document.getElementById('memberTable');
            var noMatch = document.getElementById('memberNoMatch');
            input.addEventListener('input', function () {
                var q = input.value.trim().toLowerCase();
                var shown = 0;
                var rows = table.querySelectorAll('tbody tr[data-search]');
                rows.forEach(function (tr) {
                    var match = q === '' || tr.getAttribute('data-search').indexOf(q) !== -1;
                    tr.style.display = match ? '' : 'none';
                    if (match) { shown++; }
                });
                if (noMatch) { noMatch.style.display = shown === 0 ? '' : 'none'; }
            });
        })();
    </script>
    </div>
{% endblock content %}
