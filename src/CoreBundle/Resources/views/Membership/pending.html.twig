{% extends "@SolidInvoiceCore/Layout/default_no_nav.html.twig" %}

{% block content %}
    <div class="container-tight py-5">
        <div class="text-center mb-4">
            <img src="data:image/png;base64," alt="B2B Network" style="height:64px;width:auto">
        </div>
        <div class="card card-md">
            <div class="card-body text-center p-4 p-md-5">
                <span class="avatar avatar-lg rounded-circle bg-yellow-lt mb-3">
                    {{ ux_icon('tabler:clock-hour-4', {width: 32, height: 32, class: 'text-yellow'}) }}
                </span>
                <h1 class="h2 mb-2">{{ 'Your account is pending approval'|trans }}</h1>
                <p class="text-secondary mb-4">
                    {% if company %}{{ company.name }} — {% endif %}{{ 'thanks for signing up. B2B Network is a members-only portal for wholesalers and distributors, so every new account is reviewed before it goes live. We will approve your account shortly, and once it is approved you can choose a plan and get started.'|trans }}
                </p>
                <div class="hr-text">{{ 'What happens next'|trans }}</div>
                <ul class="list-unstyled text-start mx-auto" style="max-width: 460px;">
                    <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Our team reviews your account'|trans }}</span></li>
                    <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Once approved, you pick Basic or Premium'|trans }}</span></li>
                    <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'You are ready to trade on the network'|trans }}</span></li>
                </ul>
                <div class="mt-4">
                    {# Logout requires a CSRF-protected POST (enableCsrf) - a plain
                       GET link is rejected as "Access denied". Mirror the platform
                       LogoutLink component. #}
                    <form method="post" action="{{ logout_path('main') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                        <button type="submit" class="btn btn-outline-secondary">
                            {{ ux_icon('tabler:logout', {width: 18, height: 18}) }}
                            {{ 'Log out'|trans }}
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock content %}
