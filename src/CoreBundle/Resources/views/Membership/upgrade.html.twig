{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:crown', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Membership plans'|trans }}{% endblock title %}

{% block content %}
    <div class="text-center mb-4">
        <h2 class="mb-1">{{ 'Choose the plan that fits your business'|trans }}</h2>
        <p class="text-secondary mb-0">
            {{ 'Run your invoicing on Basic, or go Premium to sell across the network with the Marketplace and your own Online Store. Billed once a year.'|trans }}
        </p>
    </div>

    <div class="row justify-content-center g-4">
        {# ---------------------------- BASIC ---------------------------- #}
        <div class="col-lg-5 col-xl-4">
            <div class="card h-100{{ currentPlan.value == 'basic' ? ' border-primary border-2' }}">
                <div class="card-body d-flex flex-column">
                    <div class="text-center mb-3">
                        <span class="badge bg-blue-lt mb-2">{{ 'Basic'|trans }}</span>
                        <div class="d-flex align-items-baseline justify-content-center gap-1">
                            <span class="h4 mb-0 text-secondary">AED</span>
                            <span class="display-5 fw-bold">{{ basicPrice }}</span>
                        </div>
                        <div class="text-secondary">{{ 'per year'|trans }}</div>
                        <p class="text-secondary small mt-2 mb-0">{{ 'Everything you need to run your books.'|trans }}</p>
                    </div>

                    <div class="hr-text hr-text-start">{{ 'Included'|trans }}</div>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Create, send and print invoices (PDF)'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Quotes and credit notes'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Clients and contacts management'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Inventory and stock tracking'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'IMEI capture and search'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-green me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Daily ledger and sales reports'|trans }}</span></li>
                        <li class="mb-2 d-flex text-secondary">{{ ux_icon('tabler:lock', {width: 18, height: 18, class: 'me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Marketplace and Online Store not included'|trans }}</span></li>
                    </ul>

                    <div class="mt-auto text-center">
                        {% if currentPlan.value == 'basic' %}
                            <span class="btn btn-outline-primary w-100 disabled">{{ 'Your current plan'|trans }}</span>
                        {% else %}
                            <span class="text-secondary small">{{ 'Entry plan'|trans }}</span>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        {# --------------------------- PREMIUM --------------------------- #}
        <div class="col-lg-5 col-xl-4">
            <div class="card h-100 border-yellow border-2 position-relative">
                <div class="ribbon ribbon-top bg-yellow text-dark">{{ ux_icon('tabler:crown', {width: 16, height: 16}) }}</div>
                <div class="card-body d-flex flex-column">
                    <div class="text-center mb-3">
                        <span class="badge bg-yellow-lt mb-2">{{ ux_icon('tabler:crown', {width: 14, height: 14, class: 'me-1'}) }}{{ 'Premium'|trans }}</span>
                        <div class="d-flex align-items-baseline justify-content-center gap-1">
                            <span class="h4 mb-0 text-secondary">AED</span>
                            <span class="display-5 fw-bold">{{ premiumPrice }}</span>
                        </div>
                        <div class="text-secondary">{{ 'per year'|trans }}</div>
                        <p class="text-secondary small mt-2 mb-0">{{ 'Sell to the whole network, not just your own customers.'|trans }}</p>
                    </div>

                    <div class="hr-text hr-text-start">{{ 'Everything in Basic, plus'|trans }}</div>
                    <ul class="list-unstyled mb-4">
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-yellow me-2 flex-shrink-0 mt-1'}) }}<span><strong>{{ 'Share your stock on the Marketplace'|trans }}</strong> — {{ 'other traders can find and buy from you'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-yellow me-2 flex-shrink-0 mt-1'}) }}<span><strong>{{ 'Your own Online Store'|trans }}</strong> — {{ 'a public shop page for your products'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-yellow me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Reach buyers across the entire B2B Network'|trans }}</span></li>
                        <li class="mb-2 d-flex">{{ ux_icon('tabler:circle-check-filled', {width: 18, height: 18, class: 'text-yellow me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Verified seller badge on your listings'|trans }}</span></li>
                        <li class="mb-2 d-flex text-secondary">{{ ux_icon('tabler:info-circle', {width: 18, height: 18, class: 'me-2 flex-shrink-0 mt-1'}) }}<span>{{ 'Requires a verified account'|trans }}</span></li>
                    </ul>

                    <div class="mt-auto text-center">
                        {% if currentPlan.value == 'premium' %}
                            <span class="btn btn-success w-100 disabled">{{ ux_icon('tabler:check', {width: 18, height: 18}) }} {{ 'Your current plan'|trans }}</span>
                        {% else %}
                            <button type="button" class="btn btn-warning w-100" disabled>
                                {{ ux_icon('tabler:credit-card', {width: 18, height: 18}) }}
                                {{ 'Upgrade to Premium'|trans }}
                            </button>
                            <p class="small text-secondary mt-2 mb-0">
                                {% if not verified %}
                                    {{ 'Your account needs to be verified first. Online card payment is being set up and will appear here shortly.'|trans }}
                                {% else %}
                                    {{ 'Online card payment is being set up. It will be available here shortly.'|trans }}
                                {% endif %}
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>

    <p class="text-center text-secondary small mt-4 mb-0">
        {{ 'Payments are billed annually. You can upgrade at any time.'|trans }}
    </p>
{% endblock content %}
