{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:crown', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Upgrade your membership'|trans }}{% endblock title %}

{% block content %}
    <div class="row justify-content-center g-4">
        <div class="col-md-5">
            <twig:Ui:Card>
                <div class="text-center">
                    <span class="badge bg-blue-lt mb-2">{{ 'Basic'|trans }}</span>
                    <div class="display-6 fw-bold">AED {{ basicPrice }}</div>
                    <div class="text-secondary mb-3">{{ 'per year'|trans }}</div>
                </div>
                <ul class="list-unstyled">
                    <li class="mb-2">{{ ux_icon('tabler:check', {width: 18, height: 18, class: 'text-green me-2'}) }}{{ 'Invoicing and all internal tools'|trans }}</li>
                    <li class="mb-2">{{ ux_icon('tabler:check', {width: 18, height: 18, class: 'text-green me-2'}) }}{{ 'Inventory, IMEI search, ledger and reports'|trans }}</li>
                    <li class="mb-2 text-secondary">{{ ux_icon('tabler:lock', {width: 18, height: 18, class: 'me-2'}) }}{{ 'Marketplace - locked'|trans }}</li>
                    <li class="mb-2 text-secondary">{{ ux_icon('tabler:lock', {width: 18, height: 18, class: 'me-2'}) }}{{ 'Online Store - locked'|trans }}</li>
                </ul>
                {% if currentPlan.value == 'basic' %}
                    <div class="alert alert-info mb-0 text-center">{{ 'Your current plan'|trans }}</div>
                {% endif %}
            </twig:Ui:Card>
        </div>

        <div class="col-md-5">
            <twig:Ui:Card>
                <div class="text-center">
                    <span class="badge bg-yellow-lt mb-2">{{ ux_icon('tabler:crown', {width: 14, height: 14, class: 'me-1'}) }}{{ 'Premium'|trans }}</span>
                    <div class="display-6 fw-bold">AED {{ premiumPrice }}</div>
                    <div class="text-secondary mb-3">{{ 'per year'|trans }}</div>
                </div>
                <ul class="list-unstyled">
                    <li class="mb-2">{{ ux_icon('tabler:check', {width: 18, height: 18, class: 'text-green me-2'}) }}{{ 'Everything in Basic'|trans }}</li>
                    <li class="mb-2">{{ ux_icon('tabler:check', {width: 18, height: 18, class: 'text-green me-2'}) }}{{ 'Share your stock on the Marketplace'|trans }}</li>
                    <li class="mb-2">{{ ux_icon('tabler:check', {width: 18, height: 18, class: 'text-green me-2'}) }}{{ 'Your own Online Store'|trans }}</li>
                    <li class="mb-2 text-secondary">{{ ux_icon('tabler:info-circle', {width: 18, height: 18, class: 'me-2'}) }}{{ 'Requires a verified account'|trans }}</li>
                </ul>
                {% if currentPlan.value == 'premium' %}
                    <div class="alert alert-success mb-0 text-center">{{ 'Your current plan'|trans }}</div>
                {% else %}
                    <button type="button" class="btn btn-primary w-100" disabled>
                        {{ ux_icon('tabler:credit-card', {width: 18, height: 18}) }}
                        {{ 'Upgrade to Premium'|trans }}
                    </button>
                    <p class="small text-secondary text-center mt-2 mb-0">
                        {{ 'Online card payment is being set up. It will be available here shortly.'|trans }}
                    </p>
                {% endif %}
            </twig:Ui:Card>
        </div>
    </div>
{% endblock content %}
