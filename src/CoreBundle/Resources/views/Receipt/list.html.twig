{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:cash', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Payments In'|trans }}{% endblock title %}

{% block heading %}
    <a href="{{ path('_receipt_new') }}" class="btn btn-primary">
        {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
        {{ 'Receive Payment'|trans }}
    </a>
{% endblock %}

{% block content %}
    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card"><div class="card-body">
                <div class="text-muted small text-uppercase">{{ 'Total received'|trans }}</div>
                <div class="h3 mb-0 text-success">AED {{ totalReceipts|number_format(2) }}</div>
            </div></div>
        </div>
    </div>

    <twig:Ui:Card>
        {% if receipts is empty %}
            <div class="text-center py-5 text-muted">
                {{ ux_icon('tabler:cash-off', {width: 40, height: 40}) }}
                <p class="mt-3 mb-1">{{ 'No payments recorded yet.'|trans }}</p>
                <a href="{{ path('_receipt_new') }}" class="btn btn-sm btn-primary mt-2">{{ 'Record your first payment'|trans }}</a>
            </div>
        {% else %}
            <div class="mb-3">
                <input type="text" id="receipt-search" class="form-control" placeholder="{{ 'Search customer, method, reference or note...'|trans }}" autocomplete="off">
            </div>
            <div class="table-responsive">
                <table class="table table-vcenter" id="receipt-table">
                    <thead>
                        <tr>
                            <th>{{ 'Date'|trans }}</th>
                            <th>{{ 'Customer'|trans }}</th>
                            <th>{{ 'Method'|trans }}</th>
                            <th>{{ 'Reference'|trans }}</th>
                            <th>{{ 'Note'|trans }}</th>
                            <th class="text-end">{{ 'Amount'|trans }}</th>
                            <th class="text-end">{{ 'Actions'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody id="receipt-body">
                        {% for receipt in receipts %}
                            <tr data-search="{{ (receipt.payerLabel ~ ' ' ~ receipt.method ~ ' ' ~ (receipt.reference ?: '') ~ ' ' ~ (receipt.note ?: ''))|lower }}">
                                <td class="text-nowrap">{{ receipt.receiptDate ? receipt.receiptDate|date('d M Y') : '—' }}</td>
                                <td class="fw-semibold">{{ receipt.payerLabel }}</td>
                                <td>{{ receipt.method }}</td>
                                <td class="text-muted">{{ receipt.reference ?: '—' }}</td>
                                <td class="text-muted">{{ receipt.note ?: '—' }}</td>
                                <td class="text-end text-success fw-semibold">AED {{ receipt.amount|number_format(2) }}</td>
                                <td class="text-end text-nowrap">
                                    <a href="{{ path('_receipt_edit', {id: receipt.id}) }}" class="btn btn-sm btn-outline-primary" title="{{ 'Edit'|trans }}">
                                        {{ ux_icon('tabler:edit', {width: 15, height: 15}) }}
                                    </a>
                                    <form method="post" action="{{ path('_receipt_delete', {id: receipt.id}) }}" class="d-inline" onsubmit="return confirm('{{ 'Delete this payment?'|trans }}');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('receipt.delete') }}">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            {{ ux_icon('tabler:trash', {width: 15, height: 15}) }}
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            <div id="receipt-no-results" class="text-center text-muted py-4" style="display: none;">{{ 'No matching payments found.'|trans }}</div>
            <script>
                (function () {
                    var input = document.getElementById('receipt-search');
                    var rows = document.querySelectorAll('#receipt-body tr');
                    var noResults = document.getElementById('receipt-no-results');
                    if (!input) { return; }
                    input.addEventListener('input', function () {
                        var q = input.value.trim().toLowerCase();
                        var shown = 0;
                        rows.forEach(function (row) {
                            var match = q === '' || row.getAttribute('data-search').indexOf(q) !== -1;
                            row.style.display = match ? '' : 'none';
                            if (match) { shown++; }
                        });
                        noResults.style.display = shown === 0 ? 'block' : 'none';
                    });
                })();
            </script>
        {% endif %}
    </twig:Ui:Card>
{% endblock content %}
