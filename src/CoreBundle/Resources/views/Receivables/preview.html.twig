{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:list-check', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Review the ledger lines'|trans }}{% endblock title %}

{% block heading %}
    <a href="{{ path('_debtors_import') }}" class="btn btn-outline-secondary">
        {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
        {{ 'Start over'|trans }}
    </a>
{% endblock %}

{% block content %}
    <style>
        .nmp-console .text-secondary { color: #64748b !important; }
        .nmp-console thead th { color: #64748b !important; }
        .nmp-console .bg-secondary-lt { background-color: #f1f5f9 !important; color: #475569 !important; }
        .nmp-console tr.row-skip { background-color: #fafafa; }
        .nmp-console tr.row-skip td { color: #94a3b8; }
        .nmp-console .match-select { min-width: 260px; }
        .nmp-console .badge-exact { background-color: #d1fae5 !important; color: #065f46 !important; }
        .nmp-console .badge-guess { background-color: #fef3c7 !important; color: #92400e !important; }
        .nmp-console .badge-new { background-color: #e0e7ff !important; color: #3730a3 !important; }
        .nmp-console tr.row-clash td { background-color: #fee2e2 !important; }
    </style>
    <div class="nmp-console">
    <twig:Ui:Card>
        <twig:block name="header">
            <h3 class="card-title mb-0">{{ 'Nothing has been saved yet'|trans }}</h3>
        </twig:block>

        <p class="text-secondary">
            {{ 'Read %count% line(s) from your file. For each one, choose which customer it belongs to - the names in Tally do not always match the names here, so check the middle column before importing. Loan, staff, visa, cargo and deposit accounts arrive unticked because they are not trading customers.'|trans({'%count%': rows|length}) }}
        </p>

        <div class="row g-2 mb-3">
            <div class="col-sm-3">
                <div class="p-2 rounded bg-secondary-lt">
                    <div class="small">{{ 'Customers owe (Debit)'|trans }}</div>
                    <div class="h3 mb-0">{{ totalOwed }}</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="p-2 rounded bg-secondary-lt">
                    <div class="small">{{ 'You owe (Credit)'|trans }}</div>
                    <div class="h3 mb-0">{{ totalOwing }}</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="p-2 rounded bg-secondary-lt">
                    <div class="small">{{ 'Lines pre-ticked'|trans }}</div>
                    <div class="h3 mb-0">{{ suggested }} / {{ rows|length }}</div>
                </div>
            </div>
            <div class="col-sm-3">
                <div class="p-2 rounded bg-secondary-lt">
                    <div class="small">{{ 'Matched to a customer'|trans }}</div>
                    <div class="h3 mb-0">{{ matched }} / {{ rows|length }}</div>
                </div>
            </div>
        </div>

        <div class="alert alert-warning" id="clashWarning" style="display: none;">
            {{ ux_icon('tabler:alert-triangle', {width: 18, height: 18, class: 'me-1'}) }}
            <span id="clashText"></span>
            {{ 'That is fine if they really are the same person - their balances will be added together - but check it is what you want.'|trans }}
        </div>

        <form method="post" action="{{ path('_debtors_import') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('debtors.import') }}">
            <input type="hidden" name="intent" value="confirm">

            <div class="mb-2 d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="tickAll">{{ 'Tick all'|trans }}</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="tickNone">{{ 'Untick all'|trans }}</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="tickCustomers">{{ 'Only trading customers'|trans }}</button>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table" id="debtorTable">
                    <thead>
                        <tr>
                            <th class="w-1">{{ 'Import'|trans }}</th>
                            <th>{{ 'Name in Tally'|trans }}</th>
                            <th>{{ 'Customer in B2B Network'|trans }}</th>
                            <th class="text-end">{{ 'Debit'|trans }}</th>
                            <th class="text-end">{{ 'Credit'|trans }}</th>
                            <th class="text-end">{{ 'Opening balance'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, row in rows %}
                            <tr class="{{ row.isCustomer ? '' : 'row-skip' }}">
                                <td>
                                    <input class="form-check-input m-0 debtor-tick" type="checkbox"
                                           name="import[{{ index }}]" value="1"
                                           data-customer="{{ row.isCustomer ? '1' : '0' }}"
                                           {{ row.isCustomer ? 'checked' : '' }}>
                                    <input type="hidden" name="name[{{ index }}]" value="{{ row.name }}">
                                    <input type="hidden" name="balance[{{ index }}]" value="{{ row.balance }}">
                                </td>
                                <td>
                                    <span class="fw-bold">{{ row.name }}</span>
                                    {% if not row.isCustomer %}
                                        <div class="small">{{ 'Looks like a loan / staff / expense account'|trans }}</div>
                                    {% endif %}
                                </td>
                                <td>
                                    <select name="match[{{ index }}]" class="form-select form-select-sm match-select">
                                        <option value="">{{ '➕ Create new customer "%name%"'|trans({'%name%': row.name}) }}</option>
                                        {% for client in clients %}
                                            <option value="{{ client.id }}"{{ row.matchId == client.id ? ' selected' : '' }}>{{ client.name }}</option>
                                        {% endfor %}
                                    </select>
                                    {% if row.matchExact %}
                                        <span class="badge badge-exact mt-1">{{ 'Exact name match'|trans }}</span>
                                    {% elseif row.matchId is not null %}
                                        <span class="badge badge-guess mt-1">{{ 'My best guess — please check'|trans }}</span>
                                    {% else %}
                                        <span class="badge badge-new mt-1">{{ 'No match found — will be created'|trans }}</span>
                                    {% endif %}
                                    {% if row.matchBalance is not null and row.matchBalance != '0.00' %}
                                        <div class="small text-secondary">{{ 'Their opening balance is currently %balance%'|trans({'%balance%': row.matchBalance}) }}</div>
                                    {% endif %}
                                </td>
                                <td class="text-end">{{ row.debit != '0.00' ? row.debit : '' }}</td>
                                <td class="text-end">{{ row.credit != '0.00' ? row.credit : '' }}</td>
                                <td class="text-end fw-bold">{{ row.balance }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">
                    {{ ux_icon('tabler:check', {width: 18, height: 18}) }}
                    {{ 'Import the ticked lines'|trans }}
                </button>
                <a href="{{ path('_debtors_import') }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans }}</a>
            </div>
        </form>
    </twig:Ui:Card>
    </div>

    <script>
        (function () {
            var ticks = document.querySelectorAll('.debtor-tick');
            var table = document.getElementById('debtorTable');
            var warning = document.getElementById('clashWarning');
            var warningText = document.getElementById('clashText');

            var setAll = function (fn) {
                ticks.forEach(function (t) { t.checked = fn(t); });
                flagClashes();
            };

            document.getElementById('tickAll').addEventListener('click', function () {
                setAll(function () { return true; });
            });
            document.getElementById('tickNone').addEventListener('click', function () {
                setAll(function () { return false; });
            });
            document.getElementById('tickCustomers').addEventListener('click', function () {
                setAll(function (t) { return t.getAttribute('data-customer') === '1'; });
            });

            // Two ticked lines pointing at the same customer are allowed - the
            // balances get added - but the user should see it happening.
            function flagClashes() {
                var counts = {};
                var rows = table.querySelectorAll('tbody tr');

                rows.forEach(function (tr) {
                    tr.classList.remove('row-clash');

                    var tick = tr.querySelector('.debtor-tick');
                    var select = tr.querySelector('.match-select');

                    if (!tick || !select || !tick.checked || select.value === '') {
                        return;
                    }

                    counts[select.value] = (counts[select.value] || 0) + 1;
                });

                var clashing = 0;

                rows.forEach(function (tr) {
                    var tick = tr.querySelector('.debtor-tick');
                    var select = tr.querySelector('.match-select');

                    if (!tick || !select || !tick.checked || select.value === '') {
                        return;
                    }

                    if (counts[select.value] > 1) {
                        tr.classList.add('row-clash');
                        clashing++;
                    }
                });

                if (clashing > 0) {
                    warningText.textContent = clashing + ' lines (highlighted below) point at the same customer.';
                    warning.style.display = '';
                } else {
                    warning.style.display = 'none';
                }
            }

            table.addEventListener('change', flagClashes);
            flagClashes();
        })();
    </script>
{% endblock content %}
