{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:list-check', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Review the ledger lines'|trans }}{% endblock title %}

{% block heading %}
    <a href="{{ path('_debtors_import') }}" class="btn btn-outline-secondary">
        {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
        {{ 'Start over'|trans }}
    </a>
{% endblock %}

{% block content %}
    <style>
        .nmp-console .text-secondary { color: #64748b !important; }
        .nmp-console thead th { color: #64748b !important; }
        .nmp-console .bg-secondary-lt { background-color: #f1f5f9 !important; color: #475569 !important; }
        .nmp-console tr.row-skip { background-color: #fafafa; }
        .nmp-console tr.row-skip td { color: #94a3b8; }
    </style>
    <div class="nmp-console">
    <twig:Ui:Card>
        <twig:block name="header">
            <h3 class="card-title mb-0">{{ 'Nothing has been saved yet'|trans }}</h3>
        </twig:block>

        <p class="text-secondary">
            {{ 'Read %count% line(s) from your file. Tick the ones to carry over as opening balances. The loan, staff, visa, cargo and deposit accounts are unticked already because they are not trading customers - tick any you do want.'|trans({'%count%': rows|length}) }}
        </p>

        <div class="row g-2 mb-3">
            <div class="col-sm-4">
                <div class="p-2 rounded bg-secondary-lt">
                    <div class="small">{{ 'Customers owe (Debit)'|trans }}</div>
                    <div class="h3 mb-0">{{ totalOwed }}</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="p-2 rounded bg-secondary-lt">
                    <div class="small">{{ 'You owe (Credit)'|trans }}</div>
                    <div class="h3 mb-0">{{ totalOwing }}</div>
                </div>
            </div>
            <div class="col-sm-4">
                <div class="p-2 rounded bg-secondary-lt">
                    <div class="small">{{ 'Lines pre-ticked'|trans }}</div>
                    <div class="h3 mb-0">{{ suggested }} / {{ rows|length }}</div>
                </div>
            </div>
        </div>

        <form method="post" action="{{ path('_debtors_import') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('debtors.import') }}">
            <input type="hidden" name="intent" value="confirm">

            <div class="mb-2 d-flex gap-2 flex-wrap">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="tickAll">{{ 'Tick all'|trans }}</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="tickNone">{{ 'Untick all'|trans }}</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="tickCustomers">{{ 'Only trading customers'|trans }}</button>
            </div>

            <div class="table-responsive">
                <table class="table table-vcenter card-table" id="debtorTable">
                    <thead>
                        <tr>
                            <th class="w-1">{{ 'Import'|trans }}</th>
                            <th>{{ 'Particulars'|trans }}</th>
                            <th class="text-end">{{ 'Debit'|trans }}</th>
                            <th class="text-end">{{ 'Credit'|trans }}</th>
                            <th class="text-end">{{ 'Opening balance'|trans }}</th>
                            <th>{{ 'On system'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for index, row in rows %}
                            <tr class="{{ row.isCustomer ? '' : 'row-skip' }}">
                                <td>
                                    <input class="form-check-input m-0 debtor-tick" type="checkbox"
                                           name="import[{{ index }}]" value="1"
                                           data-customer="{{ row.isCustomer ? '1' : '0' }}"
                                           {{ row.isCustomer ? 'checked' : '' }}>
                                    <input type="hidden" name="name[{{ index }}]" value="{{ row.name }}">
                                    <input type="hidden" name="balance[{{ index }}]" value="{{ row.balance }}">
                                </td>
                                <td>
                                    <span class="fw-bold">{{ row.name }}</span>
                                    {% if not row.isCustomer %}
                                        <div class="small">{{ 'Looks like a loan / staff / expense account'|trans }}</div>
                                    {% endif %}
                                </td>
                                <td class="text-end">{{ row.debit != '0.00' ? row.debit : '' }}</td>
                                <td class="text-end">{{ row.credit != '0.00' ? row.credit : '' }}</td>
                                <td class="text-end fw-bold">{{ row.balance }}</td>
                                <td>
                                    {% if row.existing %}
                                        <span class="badge bg-secondary-lt">{{ 'Existing customer'|trans }}</span>
                                        {% if row.existingBalance is not null and row.existingBalance != '0.00' %}
                                            <div class="small">{{ 'Currently %balance%'|trans({'%balance%': row.existingBalance}) }}</div>
                                        {% endif %}
                                    {% else %}
                                        <span class="text-secondary small">{{ 'Will be created'|trans }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">
                    {{ ux_icon('tabler:check', {width: 18, height: 18}) }}
                    {{ 'Import the ticked lines'|trans }}
                </button>
                <a href="{{ path('_debtors_import') }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans }}</a>
            </div>
        </form>
    </twig:Ui:Card>
    </div>

    <script>
        (function () {
            var ticks = document.querySelectorAll('.debtor-tick');
            var setAll = function (fn) {
                ticks.forEach(function (t) { t.checked = fn(t); });
            };
            document.getElementById('tickAll').addEventListener('click', function () {
                setAll(function () { return true; });
            });
            document.getElementById('tickNone').addEventListener('click', function () {
                setAll(function () { return false; });
            });
            document.getElementById('tickCustomers').addEventListener('click', function () {
                setAll(function (t) { return t.getAttribute('data-customer') === '1'; });
            });
        })();
    </script>
{% endblock content %}
