{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:report-money', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Daily Ledger'|trans }}{% endblock title %}

{% block heading %}
    <button type="button" class="btn btn-primary no-print" onclick="printLedger();">
        {{ ux_icon('tabler:printer', {width: 18, height: 18}) }}
        {{ 'Print / Save as PDF'|trans }}
    </button>
    <script>
        // Browsers use document.title as the default "Save as PDF" filename.
        // Swap in a dated ledger name for the print, then restore it afterwards
        // so the browser tab title is unchanged.
        (function () {
            var ledgerFileName = {{ ('nmp-daily-ledger-' ~ date|date('d-m-y'))|json_encode|raw }};
            var originalTitle = document.title;

            window.printLedger = function () {
                document.title = ledgerFileName;
                window.print();
            };

            // Restore after the print dialog closes (covers cancel too).
            window.addEventListener('afterprint', function () {
                document.title = originalTitle;
            });
        })();
    </script>
{% endblock %}

{% block content %}
    <style>
        .ledger-banner { background: linear-gradient(135deg, #206bc4 0%, #4299e1 100%); color: #fff; border: 0; }
        .ledger-banner .text-muted { color: rgba(255,255,255,.85) !important; }
        .ledger-net-positive { color: #2fb344; }
        .ledger-net-negative { color: #d63939; }

        .print-only { display: none; }
        .ledger-note-print { white-space: pre-wrap; }

        /* The scrap box reads as a notepad page - light yellow, faintly ruled. */
        .ledger-note-box {
            background-color: #fffbe6;
            border-color: #f2e3a8;
        }
        .ledger-note-box:focus {
            background-color: #fffdf2;
            border-color: #e6d074;
            box-shadow: 0 0 0 .25rem rgba(240, 224, 138, .35);
        }

        @media print {
            @page { size: A4 portrait; margin: 8mm; }
            .print-only { display: block !important; }
            .ledger-note-print { font-size: 9px !important; border: 1px solid #ddd; padding: .3rem; }
            .no-print, .navbar, .sidebar, aside, footer, .page-header .btn, .app-header, .navbar-vertical { display: none !important; }
            body { background: #fff !important; font-size: 10px !important; }
            .ledger-banner { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
            .card { border: 1px solid #ccc !important; box-shadow: none !important; margin-bottom: .4rem !important; break-inside: avoid; }
            .card-body { padding: .4rem .6rem !important; }
            h2, .h2, .h3 { font-size: 1rem !important; margin-bottom: .3rem !important; }
            .h4, .h5, h3 { font-size: .9rem !important; margin-bottom: .3rem !important; }
            table { font-size: 9px !important; }
            .table td, .table th { padding: .12rem .3rem !important; }
            .row.g-3 { --bs-gutter-y: .4rem !important; --bs-gutter-x: .4rem !important; }
            .col-lg-6 { width: 50% !important; float: left; }
            .col-md-3 { width: 25% !important; float: left; }

            /* The "Invoices raised today" card holds a 6-column table
               (Invoice, Customer, Status, Total, Paid, Balance). At 50% page
               width the Balance column overflowed and got clipped off the right
               edge in print. Give this one wide card the full page width, and
               stop the responsive wrapper from clipping (there is no scroll in
               print, so overflow:auto just cuts the content). */
            .table-responsive { overflow: visible !important; }
            .row.g-3 > .ledger-invoices-col { width: 100% !important; float: none !important; clear: both; }
            .ledger-invoices-col table { table-layout: fixed !important; width: 100% !important; }
            .ledger-invoices-col th, .ledger-invoices-col td { word-break: break-word; }
        }
    </style>

    {# ---------------- Pro banner header ---------------- #}
    <div class="card mb-3 ledger-banner">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="h2 mb-1">{{ company_name() }}</div>
                <div class="text-muted text-uppercase" style="letter-spacing: .08em;">{{ 'Daily Ledger'|trans }}</div>
            </div>
            <div class="text-end">
                <div class="h3 mb-0">{{ date|date('d M Y') }}</div>
                <div class="text-muted">{{ date|date('l') }}</div>
            </div>
        </div>
    </div>

    {# ---------------- Date picker ---------------- #}
    <div class="card mb-3 no-print">
        <div class="card-body">
            <form method="get" action="{{ path('_daily_ledger') }}" class="row g-2 align-items-end">
                <div class="col-auto">
                    <label for="ledger-date" class="form-label">{{ 'Show the day'|trans }}</label>
                    <input type="date" name="date" id="ledger-date" class="form-control" value="{{ date|date('Y-m-d') }}" onchange="this.form.submit()">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">{{ 'Show'|trans }}</button>
                </div>
                {% if date|date('Y-m-d') != today %}
                    <div class="col-auto">
                        <a href="{{ path('_daily_ledger') }}" class="btn btn-link">{{ 'Back to today'|trans }}</a>
                    </div>
                {% endif %}
            </form>
        </div>
    </div>

    {# ---------------- The day's scrap note ---------------- #}
    {# The paper notepad, kept with the day it belongs to. Free text on purpose:
       what goes in here is quoted prices, piece counts and running sums, and
       forcing that into fields would stop it being used. #}
    <twig:Ui:Card class="mb-3 ledger-note">
        <twig:block name="header">
            <h3 class="card-title mb-0">
                {{ ux_icon('tabler:notes', {width: 18, height: 18, class: 'me-1'}) }}{{ 'Notes for %date%'|trans({'%date%': date|date('d M Y')}) }}
            </h3>
        </twig:block>

        <form method="post" action="{{ path('_daily_note_save') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('daily.note') }}">
            <input type="hidden" name="date" value="{{ date|date('Y-m-d') }}">

            <textarea name="body" class="form-control no-print ledger-note-box" rows="6"
                      placeholder="{{ 'Anything you would have written on the pad - prices quoted, piece counts, who owes what, reminders…'|trans }}">{{ note ? note.body : '' }}</textarea>

            {# Printing a textarea gives an empty box, so print the text instead. #}
            {% if note and not note.isEmpty %}
                <div class="print-only ledger-note-print">{{ note.body|nl2br }}</div>
            {% endif %}

            <div class="d-flex align-items-center gap-2 mt-2 no-print flex-wrap">
                <button type="submit" class="btn btn-primary">
                    {{ ux_icon('tabler:device-floppy', {width: 16, height: 16, class: 'me-1'}) }}{{ 'Save note'|trans }}
                </button>
                {% if note and note.updatedBy %}
                    <span class="text-muted small">{{ 'Last saved by %who%'|trans({'%who%': note.updatedBy}) }}{% if note.updated %} · {{ note.updated|date('d M Y H:i') }}{% endif %}</span>
                {% endif %}
                {% if recentNotes|length > 0 %}
                    <div class="ms-auto">
                        <select class="form-select form-select-sm" style="min-width: 220px;"
                                onchange="if (this.value) { window.location = '{{ path('_daily_ledger') }}?date=' + this.value; }">
                            <option value="">{{ 'Jump to an earlier note…'|trans }}</option>
                            {% for past in recentNotes %}
                                <option value="{{ past.noteDate|date('Y-m-d') }}"{{ past.noteDate|date('Y-m-d') == date|date('Y-m-d') ? ' selected' : '' }}>
                                    {{ past.noteDate|date('d M Y') }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                {% endif %}
            </div>
        </form>
    </twig:Ui:Card>

    {# ---------------- Summary cards ---------------- #}
    <div class="row g-3 mb-3">
        <div class="col-md-3 col-6">
            <div class="card"><div class="card-body">
                <div class="text-muted small text-uppercase">{{ 'Money in (received)'|trans }}</div>
                <div class="h3 mb-0 text-success">AED {{ moneyIn|number_format(2) }}</div>
            </div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card"><div class="card-body">
                <div class="text-muted small text-uppercase">{{ 'Money out (paid)'|trans }}</div>
                <div class="h3 mb-0 text-danger">AED {{ moneyOut|number_format(2) }}</div>
            </div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card"><div class="card-body">
                <div class="text-muted small text-uppercase">{{ 'Net for the day'|trans }}</div>
                <div class="h3 mb-0 {{ net starts with '-' ? 'ledger-net-negative' : 'ledger-net-positive' }}">AED {{ net|number_format(2) }}</div>
            </div></div>
        </div>
        <div class="col-md-3 col-6">
            <div class="card"><div class="card-body">
                <div class="text-muted small text-uppercase">{{ 'Invoiced today'|trans }}</div>
                <div class="h3 mb-0">AED {{ invoicesTotal|number_format(2) }}</div>
                <div class="small text-muted">{{ billedCount }} {{ 'invoice(s)'|trans }}{% if cancelledCount > 0 %} · {{ cancelledCount }} {{ 'cancelled'|trans }}{% endif %}</div>
            </div></div>
        </div>
    </div>

    <div class="row g-3">
        {# ---------------- Money in: payments received ---------------- #}
        <div class="col-lg-6">
            <twig:Ui:Card>
                <h3 class="h5 mb-3 text-success">{{ ux_icon('tabler:arrow-down-left', {width: 18, height: 18, class: 'me-1'}) }}{{ 'Payments received'|trans }}</h3>
                {% if payments is empty and receipts|default([]) is empty %}
                    <p class="text-muted mb-0">{{ 'No payments received on this day.'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-vcenter">
                            <thead><tr><th>{{ 'Customer'|trans }}</th><th>{{ 'Invoice / Method'|trans }}</th><th class="text-end">{{ 'Amount'|trans }}</th></tr></thead>
                            <tbody>
                                {% for p in payments %}
                                    <tr>
                                        <td>{{ p.client }}</td>
                                        <td class="text-muted">{{ p.invoiceId ?: '—' }}</td>
                                        <td class="text-end text-success">AED {{ p.amount|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                                {% for r in receipts|default([]) %}
                                    <tr>
                                        <td>{{ r.payerLabel }}</td>
                                        <td class="text-muted">{{ r.method }}{{ r.reference ? ' · ' ~ r.reference : '' }}</td>
                                        <td class="text-end text-success">AED {{ r.amount|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="fw-bold"><td colspan="2" class="text-end">{{ 'Total in'|trans }}</td><td class="text-end text-success">AED {{ moneyIn|number_format(2) }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </twig:Ui:Card>
        </div>

        {# ---------------- Money out: supplier payments ---------------- #}
        <div class="col-lg-6">
            <twig:Ui:Card>
                <h3 class="h5 mb-3 text-danger">{{ ux_icon('tabler:building-store', {width: 18, height: 18, class: 'me-1'}) }}{{ 'Supplier payments'|trans }}</h3>
                {% if suppliers is empty %}
                    <p class="text-muted mb-0">{{ 'No supplier payments on this day.'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-vcenter">
                            <thead><tr><th>{{ 'Supplier'|trans }}</th><th>{{ 'Reference'|trans }}</th><th class="text-end">{{ 'Paid'|trans }}</th><th class="text-end">{{ 'Balance'|trans }}</th></tr></thead>
                            <tbody>
                                {% for s in suppliers %}
                                    <tr>
                                        <td>{{ s.supplier }}</td>
                                        <td class="text-muted">{{ s.reference ?: '—' }}</td>
                                        <td class="text-end text-danger">AED {{ s.amount|number_format(2) }}</td>
                                        <td class="text-end">AED {{ s.balance|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="fw-bold"><td colspan="2" class="text-end">{{ 'Total to suppliers'|trans }}</td><td class="text-end text-danger">AED {{ supplierOut|number_format(2) }}</td><td></td></tr>
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </twig:Ui:Card>
        </div>

        {# ---------------- Money out: expenses ---------------- #}
        <div class="col-lg-6">
            <twig:Ui:Card>
                <h3 class="h5 mb-3 text-danger">{{ ux_icon('tabler:wallet', {width: 18, height: 18, class: 'me-1'}) }}{{ 'Expenses'|trans }}</h3>
                {% if expenses is empty %}
                    <p class="text-muted mb-0">{{ 'No expenses on this day.'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-vcenter">
                            <thead><tr><th>{{ 'Category'|trans }}</th><th>{{ 'Paid to'|trans }}</th><th class="text-end">{{ 'Amount'|trans }}</th></tr></thead>
                            <tbody>
                                {% for e in expenses %}
                                    <tr>
                                        <td>{{ e.category }}</td>
                                        <td class="text-muted">{{ e.payee ?: '—' }}</td>
                                        <td class="text-end text-danger">AED {{ e.amount|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="fw-bold"><td colspan="2" class="text-end">{{ 'Total expenses'|trans }}</td><td class="text-end text-danger">AED {{ expensesOut|number_format(2) }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </twig:Ui:Card>
        </div>

        {# ---------------- Money out: refunds (cash credit notes) ---------------- #}
        <div class="col-lg-6">
            <twig:Ui:Card>
                <h3 class="h5 mb-3 text-danger">{{ ux_icon('tabler:receipt-refund', {width: 18, height: 18, class: 'me-1'}) }}{{ 'Refunds (cash)'|trans }}</h3>
                {% if refunds is empty %}
                    <p class="text-muted mb-0">{{ 'No cash refunds on this day.'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-vcenter">
                            <thead><tr><th>{{ 'Client'|trans }}</th><th>{{ 'Reason'|trans }}</th><th class="text-end">{{ 'Amount'|trans }}</th></tr></thead>
                            <tbody>
                                {% for r in refunds %}
                                    <tr>
                                        <td>{{ r.client ? r.client.name : '—' }}</td>
                                        <td class="text-muted">{{ r.reason ?: (r.reference ?: '—') }}</td>
                                        <td class="text-end text-danger">AED {{ r.amount|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="fw-bold"><td colspan="2" class="text-end">{{ 'Total refunds'|trans }}</td><td class="text-end text-danger">AED {{ refundsOut|number_format(2) }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </twig:Ui:Card>
        </div>

        {# ---------------- Invoices raised today ---------------- #}
        <div class="col-lg-6 ledger-invoices-col">
            <twig:Ui:Card>
                <h3 class="h5 mb-3">{{ ux_icon('tabler:file-invoice', {width: 18, height: 18, class: 'me-1'}) }}{{ 'Invoices raised today'|trans }}</h3>
                {% if invoices is empty %}
                    <p class="text-muted mb-0">{{ 'No invoices raised on this day.'|trans }}</p>
                {% else %}
                    <div class="table-responsive">
                        <table class="table table-vcenter">
                            <thead><tr><th>{{ 'Invoice'|trans }}</th><th>{{ 'Customer'|trans }}</th><th>{{ 'Status'|trans }}</th><th class="text-end">{{ 'Total'|trans }}</th><th class="text-end">{{ 'Paid'|trans }}</th><th class="text-end">{{ 'Balance'|trans }}</th></tr></thead>
                            <tbody>
                                {% for inv in invoices %}
                                    {% set isCancelled = inv.status == 'cancelled' %}
                                    <tr class="{{ isCancelled ? 'text-muted' : '' }}">
                                        <td>{{ inv.invoiceId ?: '—' }}</td>
                                        <td>{{ inv.client }}</td>
                                        <td><span class="badge bg-{{ inv.statusColor }}-lt">{{ inv.statusLabel }}</span></td>
                                        <td class="text-end {{ isCancelled ? 'text-decoration-line-through' : '' }}">AED {{ inv.total|number_format(2) }}</td>
                                        <td class="text-end {{ not isCancelled and inv.paid != '0.00' ? 'text-success' : '' }}">{{ isCancelled ? '—' : 'AED ' ~ inv.paid|number_format(2) }}</td>
                                        <td class="text-end {{ not isCancelled and inv.balance == '0.00' ? 'text-success' : '' }}">{{ isCancelled ? '—' : 'AED ' ~ inv.balance|number_format(2) }}</td>
                                    </tr>
                                {% endfor %}
                                <tr class="fw-bold"><td colspan="3" class="text-end">{{ 'Total billed'|trans }}</td><td class="text-end">AED {{ invoicesTotal|number_format(2) }}</td><td class="text-end text-success">AED {{ invoicesPaid|number_format(2) }}</td><td></td></tr>
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </twig:Ui:Card>
        </div>
    </div>
{% endblock content %}
