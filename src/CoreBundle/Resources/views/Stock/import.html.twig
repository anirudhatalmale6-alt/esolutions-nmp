{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:upload', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Import stock'|trans }}{% endblock title %}

{% block heading %}
    <a href="{{ path('_stock_list') }}" class="btn btn-outline-secondary">
        {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
        {{ 'Back to stock'|trans }}
    </a>
{% endblock %}

{% block content %}
    <twig:Ui:Card>
        <twig:block name="header">
            <h3 class="card-title mb-0">{{ 'Upload Tally stock summary'|trans }}</h3>
        </twig:block>

        <p class="text-muted">
            {{ 'Upload the Excel stock summary exported from Tally. This sets your opening figure - the quantity each item starts at. The file is read exactly as Tally lays it out: every model with its grade breakdown, quantities, rates and values.'|trans }}
        </p>

        <p class="text-muted">
            {{ 'After that, the system keeps count on its own: invoices take stock out, purchases put it in, refunds put returned units back. You do not need to import again.'|trans }}
        </p>

        <form method="post" action="{{ path('_stock_import') }}" enctype="multipart/form-data" class="d-flex align-items-end gap-3 flex-wrap">
            <div>
                <label for="stock-file" class="form-label">{{ 'Stock file (.xlsx / .xls)'|trans }}</label>
                <input type="file" name="stock_file" id="stock-file" class="form-control" accept=".xlsx,.xls" required>
            </div>
            <input type="hidden" name="_token" value="{{ csrf_token('stock.import') }}">
            <button type="submit" class="btn btn-primary">
                {{ ux_icon('tabler:upload', {width: 18, height: 18}) }}
                {{ 'Import'|trans }}
            </button>

            <div class="form-check w-100 mt-2">
                <input class="form-check-input" type="checkbox" name="replace_live_stock" id="replace-live-stock" value="1">
                <label class="form-check-label text-danger" for="replace-live-stock">
                    {{ 'Replace the live count'|trans }}
                    <span class="d-block text-muted small">
                        {{ 'Only tick this if you want to start again from the sheet. Everything the system has counted since the last opening figure - today\'s sales, today\'s arrivals - is discarded.'|trans }}
                    </span>
                </label>
            </div>
        </form>
    </twig:Ui:Card>

    <div class="mt-3">
        <a href="{{ path('_stock_list') }}" class="btn btn-link">{{ ux_icon('tabler:arrow-left', {width: 16, height: 16}) }} {{ 'Back to stock'|trans }}</a>
    </div>
{% endblock content %}
