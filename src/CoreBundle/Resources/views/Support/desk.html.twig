{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:message-circle', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Support Desk'|trans }}{% endblock title %}

{% block content %}
    {% set waiting = tickets|filter(t => t.awaitingOwner and t.open)|length %}

    <twig:Ui:Card>
        {% if tickets|length == 0 %}
            <p class="text-secondary mb-0">
                {{ 'Nothing has come in yet. Members reach you from Help & Support in their own menu.'|trans }}
            </p>
        {% else %}
            <p class="text-secondary mb-0">
                {% if waiting > 0 %}
                    <strong>{{ waiting }}</strong> {{ waiting == 1 ? 'conversation is waiting on you'|trans : 'conversations are waiting on you'|trans }}.
                {% else %}
                    {{ 'Nothing is waiting on you.'|trans }}
                {% endif %}
                {{ 'Waiting ones are listed first.'|trans }}
            </p>
        {% endif %}
    </twig:Ui:Card>

    {% for ticket in tickets %}
        <twig:Ui:Card>
            <div class="d-flex align-items-start justify-content-between flex-wrap gap-2 mb-2">
                <div>
                    <h4 class="mb-1">
                        {{ ticket.subject }}
                        {% if ticket.awaitingOwner and ticket.open %}
                            <span class="badge bg-red-lt ms-1">{{ 'Waiting on you'|trans }}</span>
                        {% endif %}
                    </h4>
                    <div class="text-secondary small">
                        <strong>{{ ticket.company ? ticket.company.name : 'Company removed'|trans }}</strong>
                        {% if ticket.raisedByName or ticket.raisedByEmail %}
                            &middot; {{ ticket.raisedByName ?: ticket.raisedByEmail }}
                        {% endif %}
                        {% if ticket.company and ticket.company.contactNumber %}
                            &middot; {{ ticket.company.contactNumber }}
                        {% endif %}
                        &middot; {{ ticket.kind.label|trans }}
                        {% if ticket.lastMessageAt %}
                            &middot; {{ ticket.lastMessageAt|date('j M Y, H:i') }}
                        {% endif %}
                    </div>
                </div>
                <span class="badge {{ ticket.status.badge }}">{{ ticket.status.label|trans }}</span>
            </div>

            {% for message in ticket.messages %}
                <div class="support-message {{ message.fromOwner ? 'from-owner' : '' }}">
                    <div class="text-secondary small mb-1">
                        <strong>{{ message.fromOwner ? 'You'|trans : (message.authorName ?: 'Member'|trans) }}</strong>
                        {% if message.created %}&middot; {{ message.created|date('j M Y, H:i') }}{% endif %}
                    </div>
                    <div>{{ message.body|nl2br }}</div>
                </div>
            {% endfor %}

            <form method="post" action="{{ path('_support_desk') }}" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('support.desk') }}">
                <input type="hidden" name="ticket" value="{{ ticket.id }}">

                <textarea class="form-control mb-2" name="body" rows="3" maxlength="{{ bodyMax }}"
                          placeholder="{{ 'Reply to this business'|trans }}"></textarea>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <select class="form-select w-auto" name="status">
                        {% for status in statuses %}
                            <option value="{{ status.value }}"{{ ticket.status.value == status.value ? ' selected' }}>{{ status.label|trans }}</option>
                        {% endfor %}
                    </select>
                    <button type="submit" class="btn btn-primary">
                        {{ ux_icon('tabler:send', {width: 18, height: 18, class: 'me-1'}) }}
                        {{ 'Send'|trans }}
                    </button>
                    <span class="text-secondary small">
                        {{ 'Leave the box empty to only change the status.'|trans }}
                    </span>
                </div>
            </form>
        </twig:Ui:Card>
    {% endfor %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .support-message {
            padding: .75rem 1rem;
            border-radius: .5rem;
            background: var(--tblr-bg-surface-secondary, #f8f9fa);
            margin-bottom: .75rem;
        }

        .support-message.from-owner {
            background: var(--tblr-primary-lt, #e7f3ff);
            border-left: 3px solid var(--tblr-primary, #066fd1);
        }
    </style>
{% endblock %}
