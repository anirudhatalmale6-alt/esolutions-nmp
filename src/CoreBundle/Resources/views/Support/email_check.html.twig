{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:mail-cog', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Email Check'|trans }}{% endblock title %}

{% block content %}
    <twig:Ui:Card>
        <p class="text-secondary mb-0">
            {{ 'Every email the portal sends is best-effort: a mail failure never takes down the invoice, invite or reply you had just written. The cost of that is silence. This page shows what is really configured, and will send one real email and print exactly what came back.'|trans }}
        </p>
    </twig:Ui:Card>

    {% if state.discarding %}
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-title">{{ 'Email is being thrown away'|trans }}</h4>
            <p class="mb-0">
                {{ 'No mail provider is configured anywhere on the portal, and the fallback is the "null" transport - which accepts every message and discards it without an error. Nothing you send from here is arriving. Set it under Settings, then System Settings, then Email.'|trans }}
            </p>
        </div>
    {% endif %}

    {% if state.error %}
        <div class="alert alert-warning" role="alert">{{ state.error }}</div>
    {% endif %}

    {#
     # The From address is not a free choice. Gmail refuses to relay a message
     # claiming to come from an address the signed-in account does not own, and
     # it does not refuse loudly - it rewrites the header and delivers it. So the
     # owner changes "Sends from", the send still succeeds, and every recipient
     # goes on seeing the old mailbox. There is nothing on the settings screen to
     # explain that, which is why it is spelt out here.
     #}
    {% if state.mismatch and state.overwritesFrom %}
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-title">{{ 'Your "sends from" address is being ignored'|trans }}</h4>
            <p>
                {{ 'The portal signs in to Gmail as'|trans }} <strong>{{ state.loginAccount }}</strong>,
                {{ 'and Gmail will not send as any other address. It replaces the sender with the account it is signed in as, so every email still arrives from'|trans }}
                <strong>{{ state.loginAccount }}</strong> {{ 'and not from'|trans }} <strong>{{ state.fromAddress }}</strong>.
            </p>
            <p class="mb-0">
                {{ 'To send as'|trans }} <strong>{{ state.fromAddress }}</strong>:
                {{ 'sign in to that mailbox, turn on 2-step verification and create an app password for it, then put that address and that app password into Settings, System Settings, Email, under the sending options. Changing the "sends from" field on its own cannot do it.'|trans }}
            </p>
        </div>
    {% elseif state.mismatch %}
        <div class="alert alert-warning" role="alert">
            <h4 class="alert-title">{{ 'The sender and the login do not match'|trans }}</h4>
            <p class="mb-0">
                {{ 'The portal signs in as'|trans }} <strong>{{ state.loginAccount }}</strong>
                {{ 'but sends as'|trans }} <strong>{{ state.fromAddress }}</strong>.
                {{ 'Some mail providers allow that and some quietly replace the sender or reject the message. If your emails arrive from the wrong address, or stop arriving, this is the first thing to change.'|trans }}
            </p>
        </div>
    {% endif %}

    <twig:Ui:Card>
        <h4 class="mb-3">{{ 'What is configured'|trans }}</h4>
        <div class="table-responsive">
            <table class="table table-sm mb-0">
                <tbody>
                    <tr>
                        <th style="width: 34%">{{ 'Mail provider'|trans }}</th>
                        <td>
                            {% if state.provider %}
                                <strong>{{ state.provider }}</strong>
                            {% else %}
                                <span class="text-danger">{{ 'None'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>{{ 'Taken from the settings of'|trans }}</th>
                        <td>
                            {% if state.providerOwner %}
                                {{ state.providerOwner }}
                            {% else %}
                                <span class="text-secondary">—</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>{{ 'Sends from'|trans }}</th>
                        <td>
                            {% if state.fromAddress %}
                                {{ state.fromAddress }}
                                {% if state.fromOwner %}
                                    <span class="text-secondary">({{ state.fromOwner }})</span>
                                {% endif %}
                            {% else %}
                                <span class="text-secondary">{{ 'Not set - the address of whoever triggered the email is used'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>{{ 'Signs in to the mail server as'|trans }}</th>
                        <td>
                            {% if state.loginAccount %}
                                {{ state.loginAccount }}
                                {% if state.mismatch %}
                                    <span class="text-danger ms-1">({{ 'not the same as the address above'|trans }})</span>
                                {% endif %}
                            {% else %}
                                <span class="text-secondary">{{ 'No mailbox login - this provider authorises a whole domain instead'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>{{ 'If nothing is configured'|trans }}</th>
                        <td><code>{{ state.fallbackDsn }}</code></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="text-secondary mt-3 mb-0" style="font-size: .875rem">
            {{ 'Mail settings belong to one business, but sending email is not a per-business job: somebody registering has no business yet, and a member raising a ticket is inside their own. So the portal uses your own settings if the business you are in has them, and otherwise the settings of the business it was installed for.'|trans }}
        </p>
    </twig:Ui:Card>

    {% if result %}
        <div class="alert {{ result.ok ? 'alert-success' : 'alert-danger' }}" role="alert">
            <h4 class="alert-title">
                {{ result.ok ? 'Handed to the mail server'|trans : 'It did not go'|trans }}
                {% if result.address %} — {{ result.address }}{% endif %}
            </h4>
            <p class="mb-0" style="word-break: break-word">{{ result.message }}</p>
            {% if result.hint %}
                <hr>
                <p class="mb-0">{{ result.hint }}</p>
            {% endif %}
        </div>
    {% endif %}

    {#
     # Shared hosting very often redirects outgoing mail to the hosting
     # company's own server. Symfony reports that as a certificate name
     # mismatch, which reads like a fault in the portal. This names whoever is
     # really answering, so the owner has something to send to their host.
     #}
    {% if state.target %}
        <twig:Ui:Card>
            <h4 class="mb-3">{{ 'Who answers on the mail server'|trans }}</h4>

            {% if probe %}
                {% if probe.intercepted %}
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-title">{{ 'Your host is intercepting outgoing mail'|trans }}</h4>
                        <p>
                            {{ 'The portal asked for'|trans }} <strong>{{ probe.host }}</strong>
                            {{ 'on port'|trans }} <strong>{{ probe.port }}</strong>,
                            {{ 'but the machine that answered identifies itself as'|trans }}
                            <strong>{{ probe.identity }}</strong>. {{ 'That is not the mail server you configured.'|trans }}
                        </p>
                        <p class="mb-0">
                            {{ 'Nothing on this portal can work around that. Send those two names to your hosting company and ask them to allow outbound SMTP for your account - or ask them for their own mail server details and enter those under the SMTP option instead.'|trans }}
                        </p>
                    </div>
                {% elseif not probe.reached %}
                    <div class="alert alert-danger" role="alert">
                        <h4 class="alert-title">{{ 'Nothing answered'|trans }}</h4>
                        <p class="mb-0">
                            {{ 'Nothing answered on'|trans }} <strong>{{ probe.host }}</strong>
                            {{ 'port'|trans }} <strong>{{ probe.port }}</strong>.
                            {{ 'The usual cause is the hosting company blocking outgoing mail.'|trans }}
                            {{ probe.detail }}
                        </p>
                    </div>
                {% elseif probe.identity %}
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-title">{{ 'The right mail server answered'|trans }}</h4>
                        <p class="mb-0">
                            <strong>{{ probe.host }}</strong> {{ 'on port'|trans }} <strong>{{ probe.port }}</strong>
                            {{ 'answered as'|trans }} <strong>{{ probe.identity }}</strong>.
                            {{ 'The connection is fine, so anything still failing is the sign-in or the message itself.'|trans }}
                        </p>
                    </div>
                {% else %}
                    <div class="alert alert-warning" role="alert">
                        <p class="mb-0">
                            {{ 'Something answered on'|trans }} <strong>{{ probe.host }}</strong>
                            {{ 'port'|trans }} <strong>{{ probe.port }}</strong>
                            {{ 'but did not say who it was, so this test cannot tell you either way.'|trans }}
                        </p>
                    </div>
                {% endif %}

                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <tbody>
                            <tr>
                                <th style="width: 34%">{{ 'Asked for'|trans }}</th>
                                <td>{{ probe.host }}:{{ probe.port }}</td>
                            </tr>
                            <tr>
                                <th>{{ 'Which resolves to'|trans }}</th>
                                <td>
                                    {% if probe.ip %}
                                        <code>{{ probe.ip }}</code>
                                    {% else %}
                                        <span class="text-danger">{{ 'The name could not be resolved at all'|trans }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                            <tr>
                                <th>{{ 'Answered as'|trans }}</th>
                                <td style="word-break: break-word">
                                    {% if probe.identity %}
                                        <code>{{ probe.identity }}</code>
                                        <div class="text-secondary mt-1" style="font-size: .875rem">{{ probe.detail }}</div>
                                    {% else %}
                                        <span class="text-secondary">{{ probe.detail }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            {% else %}
                <p class="text-secondary">
                    {{ 'If a test email fails with a certificate or connection error, run this. It opens a connection to'|trans }}
                    <strong>{{ state.target.host }}:{{ state.target.port }}</strong>
                    {{ 'and reports who picks up. No email is sent and no password is offered.'|trans }}
                </p>
            {% endif %}

            <form method="post" class="mt-3">
                <input type="hidden" name="_token" value="{{ csrf_token('email_check') }}">
                <input type="hidden" name="action" value="probe">
                <button type="submit" class="btn btn-outline-secondary">
                    {{ ux_icon('tabler:plug-connected', {width: 16, height: 16}) }}
                    {{ probe ? 'Check again'|trans : 'Check who answers'|trans }}
                </button>
            </form>
        </twig:Ui:Card>
    {% endif %}

    <twig:Ui:Card>
        <h4 class="mb-3">{{ 'Send a test email'|trans }}</h4>
        <form method="post" class="row g-2 align-items-end">
            <input type="hidden" name="_token" value="{{ csrf_token('email_check') }}">
            <div class="col-12 col-md-6">
                <label class="form-label" for="email-check-address">{{ 'Send it to'|trans }}</label>
                <input type="email" class="form-control" id="email-check-address" name="address"
                       value="{{ myAddress }}" placeholder="you@example.com">
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    {{ ux_icon('tabler:send', {width: 16, height: 16}) }}
                    {{ 'Send test'|trans }}
                </button>
            </div>
        </form>
        <p class="text-secondary mt-3 mb-0" style="font-size: .875rem">
            {{ 'One email, to that address only. Nobody else is written to.'|trans }}
        </p>
    </twig:Ui:Card>
{% endblock content %}
