{% extends "@SolidInvoiceCore/Layout/default.html.twig" %}

{% block title %}{{ ux_icon('tabler:message-circle', {width: 24, height: 24, class: 'me-2'}) }}{{ 'Help & Support'|trans }}{% endblock title %}

{% block content %}
    <twig:Ui:Card>
        <h3 class="mb-1">{{ 'Tell us about it'|trans }}</h3>
        <p class="text-secondary" style="max-width: 720px;">
            {{ 'Found something broken, stuck on something, or got an idea? Write it here and it goes straight to the team. You will see the reply on this page - there is nothing to check anywhere else.'|trans }}
        </p>

        <form method="post" action="{{ path('_support') }}" class="mt-3" style="max-width: 720px;">
            <input type="hidden" name="_token" value="{{ csrf_token('support.member') }}">
            <input type="hidden" name="intent" value="open">

            <div class="mb-3">
                <label class="form-label fw-semibold" for="support-kind">{{ 'What is this about?'|trans }}</label>
                <select class="form-select" id="support-kind" name="kind">
                    {% for kind in kinds %}
                        <option value="{{ kind.value }}">{{ kind.label|trans }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="support-subject">{{ 'In a few words'|trans }}</label>
                <input class="form-control" type="text" id="support-subject" name="subject"
                       maxlength="{{ subjectMax }}" required
                       placeholder="{{ 'Stock import is not reading my file'|trans }}">
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="support-body">{{ 'What happened?'|trans }}</label>
                <textarea class="form-control" id="support-body" name="body" rows="5"
                          maxlength="{{ bodyMax }}" required
                          placeholder="{{ 'What you were doing, what you expected, and what happened instead. The page address helps too.'|trans }}"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                {{ ux_icon('tabler:send', {width: 18, height: 18, class: 'me-1'}) }}
                {{ 'Send'|trans }}
            </button>
        </form>
    </twig:Ui:Card>

    {% if tickets|length > 0 %}
        <twig:Ui:Card>
            <h3 class="mb-3">{{ 'Your conversations'|trans }}</h3>

            <div class="accordion" id="support-threads">
                {% for ticket in tickets %}
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                                    data-bs-target="#ticket-{{ ticket.id }}" aria-expanded="false">
                                <span class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge {{ ticket.status.badge }}">{{ ticket.status.label|trans }}</span>
                                    <strong>{{ ticket.subject }}</strong>
                                    <span class="text-secondary small">{{ ticket.kind.label|trans }}</span>
                                    {% if ticket.lastMessageAt %}
                                        <span class="text-secondary small">&middot; {{ ticket.lastMessageAt|date('j M Y') }}</span>
                                    {% endif %}
                                </span>
                            </button>
                        </h2>
                        <div id="ticket-{{ ticket.id }}" class="accordion-collapse collapse" data-bs-parent="#support-threads">
                            <div class="accordion-body">
                                {% for message in ticket.messages %}
                                    <div class="support-message {{ message.fromOwner ? 'from-owner' : '' }}">
                                        <div class="text-secondary small mb-1">
                                            {% if message.fromOwner %}
                                                <strong>{{ 'B2B Network team'|trans }}</strong>
                                            {% else %}
                                                <strong>{{ message.authorName ?: 'You'|trans }}</strong>
                                            {% endif %}
                                            {% if message.created %}
                                                &middot; {{ message.created|date('j M Y, H:i') }}
                                            {% endif %}
                                        </div>
                                        <div>{{ message.body|nl2br }}</div>
                                    </div>
                                {% endfor %}

                                {% if ticket.open %}
                                    <form method="post" action="{{ path('_support') }}" class="mt-3">
                                        <input type="hidden" name="_token" value="{{ csrf_token('support.member') }}">
                                        <input type="hidden" name="intent" value="reply">
                                        <input type="hidden" name="ticket" value="{{ ticket.id }}">
                                        <textarea class="form-control mb-2" name="body" rows="3"
                                                  maxlength="{{ bodyMax }}"
                                                  placeholder="{{ 'Add to this conversation'|trans }}"></textarea>
                                        <button type="submit" class="btn btn-outline-primary btn-sm">{{ 'Send'|trans }}</button>
                                    </form>
                                {% else %}
                                    <p class="text-secondary small mt-3 mb-0">
                                        {{ 'This one is closed. If it comes back, start a new one above.'|trans }}
                                    </p>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </twig:Ui:Card>
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .support-message {
            padding: .75rem 1rem;
            border-radius: .5rem;
            background: var(--tblr-bg-surface-secondary, #f8f9fa);
            margin-bottom: .75rem;
        }

        /* The team's replies read differently from your own words, so the thread
           can be followed without reading every name. */
        .support-message.from-owner {
            background: var(--tblr-primary-lt, #e7f3ff);
            border-left: 3px solid var(--tblr-primary, #066fd1);
        }
    </style>
{% endblock %}
