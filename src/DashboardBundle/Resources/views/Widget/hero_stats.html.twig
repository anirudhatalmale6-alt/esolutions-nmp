<style>
    /* Clickable stat cards jump straight to the matching invoice list */
    .dashboard-hero-stats a.stat-card{text-decoration:none;color:inherit;display:block}
    .dashboard-hero-stats a.stat-card:hover{box-shadow:var(--swp-shadow-md);transform:translateY(-2px)}
    .stat-card-hint{color:var(--swp-primary);font-size:var(--swp-text-xs);font-weight:var(--swp-font-semibold);margin-top:2px;display:inline-block}
    /* Shrink so the cards stay readable on phones and small tablets */
    @media (max-width:768px){
        .dashboard-hero-stats .stat-value{font-size:1.15rem;line-height:1.15}
        .dashboard-hero-stats .stat-subvalue{font-size:.72rem}
        .dashboard-hero-stats .stat-label{font-size:.62rem}
        .dashboard-hero-stats .stat-icon{width:38px;height:38px}
        .dashboard-hero-stats .stat-card{padding:var(--swp-space-4)}
        .dashboard-hero-stats .stat-card-content{gap:var(--swp-space-3)}
    }
</style>
<div class="col-12">
    <div class="dashboard-hero-stats">
        <a class="stat-card" href="{{ path('_invoices_index') }}?status=pending">
            <div class="stat-card-content">
                <div class="stat-icon stat-icon--primary">
                    {{ ux_icon('tabler:file-invoice', {width: 24, height: 24}) }}
                </div>
                <div class="stat-info">
                    <span class="stat-label">{{ 'dashboard.hero.outstanding'|trans }}</span>
                    <span class="stat-value">
                        {% for currency, amount in totalOutstanding %}
                            {{ amount|formatCurrency(currency) }}{% if not loop.last %}<br>{% endif %}
                        {% else %}
                            {{ 0|formatCurrency }}
                        {% endfor %}
                    </span>
                    <span class="stat-card-hint">{{ ux_icon('tabler:arrow-right', {width: 13, height: 13}) }} View unpaid</span>
                </div>
            </div>
        </a>

        <div class="stat-card stat-card--danger">
            <div class="stat-card-content">
                <div class="stat-icon stat-icon--danger">
                    {{ ux_icon('tabler:alert-triangle', {width: 24, height: 24}) }}
                </div>
                <div class="stat-info">
                    <span class="stat-label">{{ 'dashboard.hero.overdue'|trans }}</span>
                    <span class="stat-value stat-value--danger">{{ overdueCount }}</span>
                    {% if overdueAmount is not empty %}
                        <span class="stat-subvalue">
                            {% for currency, amount in overdueAmount %}
                                {{ amount|formatCurrency(currency) }}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="stat-card">
            <div class="stat-card-content">
                <div class="stat-icon stat-icon--success">
                    {{ ux_icon('tabler:calendar-stats', {width: 24, height: 24}) }}
                </div>
                <div class="stat-info">
                    <span class="stat-label">{{ 'dashboard.hero.this_month'|trans }}</span>
                    <span class="stat-value">
                        {% for currency, amount in paymentsThisMonth %}
                            {{ amount|formatCurrency(currency) }}{% if not loop.last %}<br>{% endif %}
                        {% else %}
                            {{ 0|formatCurrency }}
                        {% endfor %}
                    </span>
                </div>
            </div>
        </div>

        <div class="stat-card stat-card--success">
            <div class="stat-card-content">
                <div class="stat-icon stat-icon--success">
                    {{ ux_icon('tabler:trending-up', {width: 24, height: 24}) }}
                </div>
                <div class="stat-info">
                    <span class="stat-label">{{ 'dashboard.hero.total_revenue'|trans }}</span>
                    <span class="stat-value stat-value--success">
                        {% for currency, amount in totalRevenue %}
                            {{ amount|formatCurrency(currency) }}{% if not loop.last %}<br>{% endif %}
                        {% else %}
                            {{ 0|formatCurrency }}
                        {% endfor %}
                    </span>
                </div>
            </div>
        </div>
    </div>
</div>
