<div {{ attributes.defaults({class: 'billing-form-page'}) }}>
    {% set currency = dto.client ? dto.client.currency : null %}

    {{ form_start(form) }}

    <div class="billing-form-container">
        {# Page Header #}
        <div class="billing-form-header">
            <div class="billing-form-header-content">
                <div class="billing-form-icon">
                    {{ ux_icon('tabler:file-invoice', {width: 28, height: 28}) }}
                </div>
                <div>
                    {% if isEdit %}
                        <h1 class="billing-form-title">{{ 'invoice.edit.title'|trans }}</h1>
                    {% else %}
                        <h1 class="billing-form-title">{{ 'invoice.create.title'|trans }}</h1>
                        <p class="billing-form-subtitle">{{ 'invoice.create.subtitle'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Invoice Details Section (Client, Invoice ID, Dates) #}
        <div class="billing-details-section">
            <div class="billing-details-grid">
                {# Left Column: Client Selection + Invoice ID #}
                <div class="billing-details-left">
                    {# Client Selection #}
                    <div class="client-selection">
                        {# Mode Toggle #}
                        <div class="client-mode-toggle mb-3{{ not this.hasClients() ? ' d-none' }}">
                            {{ form_row(form.clientMode, {'attr': {'class': 'd-flex gap-2'}}) }}
                        </div>

                        {% set mode = form.clientMode.vars.data %}

                        {% if mode.value == 'existing' %}
                            {# Existing client selection (autocomplete or info card) #}
                            <div{{ form.client is defined and form.client.vars.data is not empty ? ' class="d-none"' }}>
                                {% if form.client is defined %}
                                    {{ form_row(form.client, {attr: {'data-action': 'live#$render'}}) }}
                                {% endif %}
                            </div>
                            {% if form.client is defined and form.client.vars.data %}
                                {% include "@SolidInvoiceClient/Ajax/info.html.twig" with {'client': form.client.vars.data, 'form': form} %}
                            {% endif %}
                        {% else %}
                            {# New client inline form #}
                            <div class="inline-client-form card">
                                <div class="card-body">
                                    <div class="inline-client-header mb-3">
                                        <h3 class="h5 mb-0">
                                            {{ ux_icon('tabler:user-plus', {width: 20, height: 20}) }}
                                            {{ 'invoice.client.create_new'|trans }}
                                        </h3>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-12">
                                            {{ form_row(form.newClientName) }}
                                        </div>
                                        <div class="col-md-6">
                                            {{ form_row(form.newContactFirstName) }}
                                        </div>
                                        <div class="col-md-6">
                                            {{ form_row(form.newContactLastName) }}
                                        </div>
                                        <div class="col-12">
                                            {{ form_row(form.newContactEmail) }}
                                        </div>
                                    </div>

                                    <div class="alert alert-info mt-3 mb-0">
                                        {{ ux_icon('tabler:info-circle', {width: 16, height: 16}) }}
                                        <small>{{ 'invoice.client.inline.currency_note'|trans }}</small>
                                    </div>
                                </div>
                            </div>
                        {% endif %}
                    </div>

                    {# Invoice ID #}
                    <div {{ stimulus_controller('billing-id') }}>
                        <span {{ stimulus_target('billing-id', 'info') }}>
                            <div class="billing-id-display">
                                <span class="billing-id-label">{{ 'invoice.label'|trans }}</span>
                                <span class="billing-id-value" {{ stimulus_target('billing-id', 'value') }}>{{ form.invoiceId.vars.data }}</span>
                                {% if editInvoiceId is not defined or editInvoiceId is not same as(false) %}
                                    <button type="button" class="billing-id-edit" {{ stimulus_action('billing-id', 'edit') }} aria-label="{{ 'invoice.id.edit'|trans }}" title="{{ 'Edit'|trans }}">
                                        {{ ux_icon('tabler:pencil', {width: 16, height: 16}) }}
                                    </button>
                                {% endif %}
                            </div>
                        </span>

                        <div class="d-none billing-id-form" {{ stimulus_target('billing-id', 'form') }}>
                            {{ form_label(form.invoiceId) }}
                            <div class="input-group">
                                {{ form_widget(form.invoiceId, {attr: {class: 'form-control'}}) }}
                                <button class="btn btn-outline-primary" type="button" {{ stimulus_action('billing-id', 'save') }} aria-label="{{ 'invoice.id.save'|trans }}" title="{{ 'Save'|trans }}">
                                    {{ ux_icon('tabler:check', {width: 18, height: 18}) }}
                                </button>
                                <button class="btn btn-outline-secondary" type="button" {{ stimulus_action('billing-id', 'cancel') }} aria-label="{{ 'invoice.id.cancel'|trans }}" title="{{ 'Cancel'|trans }}">
                                    {{ ux_icon('tabler:x', {width: 18, height: 18}) }}
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                {# Right Column: Dates + Discount #}
                <div class="billing-details-right">
                    <div class="invoice-dates-row">
                        {{ form_row(form.invoiceDate) }}
                        {{ form_row(form.due) }}
                    </div>
                    {{ form_row(form.discount) }}
                </div>
            </div>
        </div>

        {# Main Content: 2-Column Layout #}
        <div class="billing-form-main">
            {# Line Items Section #}
            <div class="billing-items-section">
                <div class="billing-items-header">
                    <div class="billing-items-icon">
                        {{ ux_icon('tabler:list-details', {width: 20, height: 20}) }}
                    </div>
                    <h2 class="billing-items-title">{{ 'invoice.items.title'|trans }}</h2>
                </div>

                <div class="billing-items-body">
                    {# Empty State #}
                    {% if form.lines|length == 0 %}
                        <div class="empty">
                            <div class="empty-icon">
                                {{ ux_icon('tabler:file-plus', {width: 32, height: 32}) }}
                            </div>
                            <p class="empty-title">{{ 'invoice.items.empty.title'|trans }}</p>
                            <p class="empty-subtitle text-muted">{{ 'invoice.items.empty.description'|trans }}</p>
                        </div>
                    {% else %}
                        {# Responsive Line Items - Table on desktop, stacked on mobile via CSS #}
                        <div class="billing-items-list">
                            <div class="billing-items-header-row">
                                <div class="column-description">{{ 'invoice.item.heading.description'|trans }}</div>
                                <div class="column-price">{{ 'invoice.item.heading.price'|trans }}</div>
                                <div class="column-qty">{{ 'invoice.item.heading.qty'|trans }}</div>
                                {% if hasTax %}
                                    <div class="column-tax">{{ 'invoice.item.heading.tax'|trans }}</div>
                                {% endif %}
                                <div class="column-total">{{ 'invoice.item.heading.total'|trans }}</div>
                                <div class="column-actions"></div>
                            </div>

                            {% for index, item in form.lines %}
                                <div class="billing-item-row">
                                    <div class="column-description">
                                        <span class="mobile-label">{{ 'invoice.item.heading.description'|trans }}</span>
                                        {{ form_widget(item.description, {attr: {placeholder: 'invoice.item.description.placeholder'|trans, rows: 2}}) }}
                                        {# The stock item behind this line, set by the model picker. Sits
                                           beside the description so the picker can find it as a sibling.
                                           Empty = a line that is not stock, which moves no quantity. #}
                                        {{ form_widget(item.stockModel) }}
                                        {# And which grade of it, because that is what is actually sold
                                           and what the quantity comes out of. #}
                                        {{ form_widget(item.stockGrade) }}
                                        {# And, when the line is sold as a mix, what the mix is made of.
                                           The customer's copy shows one line for the lot; this is what
                                           tells the warehouse which grades it really came out of. #}
                                        {{ form_widget(item.gradeSplit) }}
                                        <span class="nmp-grade-badge" data-stock-grade-label></span>
                                        <div class="nmp-mix" data-grade-mix></div>
                                        {# Where private wording goes. The box above is the customer's
                                           line and is printed word for word; this one never leaves the
                                           office. #}
                                        {{ form_widget(item.internalNote) }}
                                        {{ form_errors(item.internalNote) }}
                                        {{ form_errors(item.description) }}
                                    </div>
                                    <div class="column-price">
                                        <span class="mobile-label">{{ 'invoice.item.heading.price'|trans }}</span>
                                        {{ form_widget(item.price) }}
                                        {{ form_errors(item.price) }}
                                    </div>
                                    <div class="column-qty">
                                        <span class="mobile-label">{{ 'invoice.item.heading.qty'|trans }}</span>
                                        {{ form_widget(item.qty) }}
                                        {{ form_errors(item.qty) }}
                                    </div>
                                    {% if hasTax %}
                                        <div class="column-tax">
                                            <span class="mobile-label">{{ 'invoice.item.heading.tax'|trans }}</span>
                                            {% if item.taxes is defined %}
                                                <div class="line-tax-collection" {{ stimulus_controller('line-tax') }}>
                                                    {% if item.taxes|length > 0 %}
                                                        <div class="line-tax-list">
                                                            {% for taxIndex, lineTax in item.taxes %}
                                                                <div class="line-tax-row" data-line-tax-target="row">
                                                                    <div class="line-tax-field line-tax-field-tax">
                                                                        {{ form_widget(lineTax.tax) }}
                                                                        {{ form_errors(lineTax.tax) }}
                                                                    </div>
                                                                    {{ form_widget(lineTax.sequence) }}
                                                                    <div class="line-tax-actions">
                                                                        {{ form_widget(lineTax.vars.button_delete, {
                                                                            label: ux_icon('tabler:x', {width: 14, height: 14})|raw,
                                                                            label_html: true,
                                                                            attr: {class: 'btn btn-sm line-tax-remove-btn', title: 'invoice.item.tax.remove'|trans, 'aria-label': 'invoice.item.tax.remove'|trans}
                                                                        }) }}
                                                                    </div>
                                                                </div>
                                                            {% endfor %}
                                                        </div>
                                                    {% endif %}
                                                    {{ form_widget(item.taxes.vars.button_add, {
                                                        label: 'invoice.item.tax.add'|trans,
                                                        attr: {class: 'line-tax-add-btn'}
                                                    }) }}
                                                </div>
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    <div class="column-total">
                                        <span class="mobile-label">{{ 'invoice.item.heading.total'|trans }}</span>
                                        <span class="item-total-value">{{ item.vars.value.total|formatCurrency(currency) }}</span>
                                    </div>
                                    <div class="column-actions">
                                        {# Internal IMEI capture for this line: a hidden value plus a button
                                           that opens the scan/enter popup. A gold dot shows when IMEIs are
                                           saved. The IMEI never appears on the customer PDF or public view. #}
                                        {{ form_widget(item.imei) }}
                                        <button type="button" class="btn btn-sm imei-line-btn" data-imei-open
                                                title="{{ 'Scan / enter IMEI(s)'|trans }}" aria-label="{{ 'Scan / enter IMEI(s)'|trans }}">
                                            {{ ux_icon('tabler:barcode', {width: 16, height: 16}) }}
                                            <span class="imei-dot" data-imei-dot{{ item.vars.value.imei is empty ? ' hidden' : '' }}></span>
                                        </button>
                                        {% if form.lines|length > 1 %}
                                            {{ form_widget(item.vars.button_delete, {
                                                label: ux_icon('tabler:trash', {width: 16, height: 16})|raw,
                                                label_html: true,
                                                attr: {class: 'btn btn-sm remove-item-btn', title: 'invoice.item.remove'|trans, 'aria-label': 'invoice.item.remove'|trans}
                                            }) }}
                                        {% endif %}
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}

                    {# Add Item Button #}
                    <div class="add-item-action">
                        {{ form_widget(form.lines.vars.button_add, {
                            label: 'invoice.item.add'|trans,
                            attr: {class: 'add-item-btn btn-sm'}
                        }) }}
                    </div>
                </div>

                {% if hasTax %}
                    {# Invoice-Level Taxes Section (Withholding & adjustments) #}
                    <div class="billing-invoice-taxes" {{ stimulus_controller('invoice-tax') }}>
                        <div class="billing-invoice-taxes-header">
                            <div class="billing-items-icon">
                                {{ ux_icon('tabler:receipt-tax', {width: 18, height: 18}) }}
                            </div>
                            <h3 class="billing-invoice-taxes-title">{{ 'invoice.invoice_taxes.title'|trans }}</h3>
                            <p class="billing-invoice-taxes-subtitle text-muted">{{ 'invoice.invoice_taxes.subtitle'|trans }}</p>
                        </div>

                        {% if form.invoiceTaxes|length > 0 %}
                            <div class="billing-invoice-taxes-list">
                                {% for index, invoiceTax in form.invoiceTaxes %}
                                    <div class="billing-invoice-tax-row" data-invoice-tax-target="row">
                                        <div class="invoice-tax-field invoice-tax-field-tax">
                                            <span class="mobile-label">{{ 'invoice.invoice_taxes.heading.tax'|trans }}</span>
                                            {{ form_widget(invoiceTax.tax) }}
                                            {{ form_errors(invoiceTax.tax) }}
                                        </div>
                                        <div class="invoice-tax-field invoice-tax-field-direction">
                                            <span class="mobile-label">{{ 'invoice.invoice_taxes.heading.direction'|trans }}</span>
                                            {{ form_widget(invoiceTax.direction) }}
                                            {{ form_errors(invoiceTax.direction) }}
                                        </div>
                                        <div class="invoice-tax-field invoice-tax-field-note">
                                            <span class="mobile-label">{{ 'invoice.invoice_taxes.heading.note'|trans }}</span>
                                            {{ form_widget(invoiceTax.note) }}
                                            {{ form_errors(invoiceTax.note) }}
                                        </div>
                                        {{ form_widget(invoiceTax.sequence) }}
                                        <div class="invoice-tax-actions">
                                            {{ form_widget(invoiceTax.vars.button_delete, {
                                                label: ux_icon('tabler:trash', {width: 16, height: 16})|raw,
                                                label_html: true,
                                                attr: {class: 'btn btn-sm remove-item-btn', title: 'invoice.invoice_taxes.remove'|trans, 'aria-label': 'invoice.invoice_taxes.remove'|trans}
                                            }) }}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="add-item-action">
                            {{ form_widget(form.invoiceTaxes.vars.button_add, {
                                label: 'invoice.invoice_taxes.add'|trans,
                                attr: {class: 'add-item-btn btn-sm'}
                            }) }}
                        </div>
                    </div>
                {% endif %}
            </div>

            {# Totals Sidebar #}
            <div class="billing-totals-sidebar">
                <div class="billing-totals-card">
                    <div class="billing-totals-header">
                        <div class="billing-totals-icon">
                            {{ ux_icon('tabler:calculator', {width: 20, height: 20}) }}
                        </div>
                        <h2 class="billing-totals-title">{{ 'invoice.totals.title'|trans }}</h2>
                    </div>

                    <div class="billing-totals-body">
                        <div class="totals-row">
                            <span class="totals-label">{{ 'billing.subtotal'|trans }}</span>
                            <span class="totals-value">{{ dto.baseTotal|formatCurrency(currency) }}</span>
                        </div>

                        {% if hasTax %}
                            <div class="totals-row">
                                <span class="totals-label">{{ 'billing.tax'|trans }}</span>
                                <span class="totals-value">{{ dto.tax|formatCurrency(currency) }}</span>
                            </div>
                        {% endif %}

                        <div class="totals-row totals-row-discount">
                            <span class="totals-label">{{ 'billing.discount'|trans }}</span>
                            <span class="totals-value">{{ this.discountAmount|formatCurrency(currency) }}</span>
                        </div>

                        <div class="totals-row totals-row-total">
                            <span class="totals-label">{{ 'billing.total'|trans }}</span>
                            <span class="totals-value">{{ dto.total|formatCurrency(currency) }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Custom Fields - Collapsible Section #}
        {% if form.customFields|length > 0 %}
            <details class="billing-terms-section" open>
                <summary class="terms-summary" aria-label="{{ 'Custom fields'|trans }}">
                    <span class="terms-summary-icon">
                        {{ ux_icon('tabler:chevron-right', {width: 18, height: 18}) }}
                    </span>
                    <span class="terms-summary-text">
                        <span class="terms-summary-title">{{ 'Custom fields'|trans }}</span>
                    </span>
                </summary>
                <div class="terms-content">
                    <div class="row g-3">
                        {% for child in form.customFields %}
                            <div class="col-md-6">{{ form_row(child) }}</div>
                        {% endfor %}
                    </div>
                </div>
            </details>
        {% endif %}

        {# Terms & Notes - Collapsible Section #}
        <details class="billing-terms-section"{{ hasTermsOrNotes ? ' open' : '' }}>
            <summary class="terms-summary" aria-label="{{ 'invoice.terms_notes.toggle'|trans }}">
                <span class="terms-summary-icon">
                    {{ ux_icon('tabler:chevron-right', {width: 18, height: 18}) }}
                </span>
                <span class="terms-summary-text">
                    <span class="terms-summary-title">{{ 'invoice.terms_notes.title'|trans }}</span>
                    <span class="badge bg-secondary-lt">{{ 'optional'|trans }}</span>
                </span>
            </summary>
            <div class="terms-content">
                <div class="terms-grid">
                    {{ form_row(form.terms) }}
                    {{ form_row(form.notes) }}
                </div>
            </div>
        </details>

        {# Hidden fields #}
        {{ form_widget(form.total) }}
        {{ form_widget(form.baseTotal) }}
        {{ form_widget(form.tax) }}

        {# Sticky Form Actions #}
        <div class="billing-form-actions">
            <div class="billing-form-actions-inner">
                <a href="{{ path('_invoices_index') }}" class="btn btn-ghost">
                    {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
                    {{ 'invoice.save.cancel'|trans }}
                </a>

                <div class="btn-group save-button-group">
                    {% if isEdit %}
                        <button type="button" class="btn btn-primary btn-save-primary" {{ live_action('saveUpdate:prevent') }}>
                            {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                            {{ 'invoice.save.update'|trans }}
                        </button>
                        <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">{{ 'invoice.view.toolbar.toggle_dropdown'|trans }}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button type="button" class="dropdown-item" {{ live_action('savePublish:prevent') }}>
                                    {{ ux_icon('tabler:check', {width: 16, height: 16}) }}
                                    {{ 'invoice.save.publish'|trans }}
                                </button>
                            </li>
                            {% if not is_email_verification_gated() %}
                            <li>
                                <button type="button" class="dropdown-item" {{ live_action('saveSend:prevent') }}>
                                    {{ ux_icon('tabler:send', {width: 16, height: 16}) }}
                                    {{ 'invoice.save.send'|trans }}
                                </button>
                            </li>
                            {% endif %}
                        </ul>
                    {% else %}
                        <button type="button" class="btn btn-primary btn-save-primary" {{ live_action('saveDraft:prevent') }}>
                            {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                            {{ 'invoice.save.draft'|trans }}
                        </button>
                        <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">{{ 'invoice.view.toolbar.toggle_dropdown'|trans }}</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <button type="button" class="dropdown-item" {{ live_action('savePublish:prevent') }}>
                                    {{ ux_icon('tabler:check', {width: 16, height: 16}) }}
                                    {{ 'invoice.save.publish'|trans }}
                                </button>
                            </li>
                            {% if not is_email_verification_gated() %}
                            <li>
                                <button type="button" class="dropdown-item" {{ live_action('saveSend:prevent') }}>
                                    {{ ux_icon('tabler:send', {width: 16, height: 16}) }}
                                    {{ 'invoice.save.send'|trans }}
                                </button>
                            </li>
                            {% endif %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {{ form_end(form) }}

    {# ---- Internal IMEI capture popup, shared by every line ---- #}
    <dialog id="imei-dialog" class="imei-dialog">
        <div class="imei-dialog-head">{{ 'IMEI numbers'|trans }}</div>
        <p class="imei-dialog-hint">{{ 'One IMEI per line. Scan each handset with your barcode scanner, or type the numbers in.'|trans }}</p>
        <textarea id="imei-dialog-text" rows="8" class="form-control" spellcheck="false" autocomplete="off"></textarea>
        <div class="imei-dialog-actions">
            <button type="button" class="btn btn-ghost" data-imei-cancel>{{ 'Cancel'|trans }}</button>
            <button type="button" class="btn btn-primary" data-imei-save>{{ 'Save IMEIs'|trans }}</button>
        </div>
    </dialog>

    <style>
        .column-actions { display: flex; align-items: center; justify-content: flex-end; gap: .25rem; }
        /* The line row's actions track was sized (24px) for a single delete button.
           Adding the IMEI button needs room for two, and the Total column
           (minmax(60px,.4fr)) was too narrow for a full currency amount so the
           no-wrap total spilled into the actions - which read as the barcode icon
           "overlaying" the total. Give both the Total and Actions tracks proper
           width on desktop; the mobile (<=900px) stacked grid-areas layout is
           untouched. */
        @media (min-width: 901px) {
            .billing-items-list:not(:has(.column-tax)) .billing-items-header-row,
            .billing-items-list:not(:has(.column-tax)) .billing-item-row {
                grid-template-columns: minmax(0,3.4fr) minmax(100px,.9fr) 56px minmax(120px,.6fr) 66px !important;
            }
            .billing-items-list:has(.column-tax) .billing-items-header-row,
            .billing-items-list:has(.column-tax) .billing-item-row {
                grid-template-columns: minmax(0,2.4fr) minmax(120px,1fr) 56px minmax(120px,.8fr) minmax(120px,.6fr) 66px !important;
            }
        }
        .column-total .item-total-value { white-space: nowrap; }
        /* The internal note sits under the description and has to look unlike
           it, so nobody mistakes one for the other while typing. */
        .column-description textarea.nmp-note-input {
            margin-top: .3rem;
            font-size: .78rem;
            line-height: 1.35;
            min-height: 0;
            padding: .2rem .45rem;
            color: var(--bs-secondary-color, #6c757d);
            background: var(--bs-secondary-bg, #f6f8fa);
            border-style: dashed;
        }
        .column-description textarea.nmp-note-input::placeholder { font-style: italic; }
        .column-description textarea.nmp-note-input:focus {
            color: var(--bs-body-color);
            background: var(--bs-body-bg, #fff);
            border-style: solid;
        }
        .imei-line-btn { position: relative; }
        .imei-dot { position: absolute; top: 1px; right: 1px; width: 9px; height: 9px; border-radius: 50%; background: #f4c430; box-shadow: 0 0 0 2px var(--bs-body-bg, #fff); }
        .imei-dot[hidden] { display: none; }
        .imei-dialog { border: none; border-radius: 12px; padding: 20px; max-width: 420px; width: 92vw; color: var(--bs-body-color); background: var(--bs-body-bg, #fff); box-shadow: 0 20px 60px -20px rgba(0,0,0,.45); }
        .imei-dialog::backdrop { background: rgba(0,0,0,.4); }
        .imei-dialog-head { font-size: 1.05rem; font-weight: 600; margin-bottom: .35rem; }
        .imei-dialog-hint { color: var(--bs-secondary-color, #6c757d); font-size: .85rem; margin: 0 0 .75rem; }
        .imei-dialog textarea { width: 100%; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
        .imei-dialog-actions { display: flex; justify-content: flex-end; gap: .5rem; margin-top: .9rem; }
    </style>

    <script>
        (function () {
            if (window.__imeiPopupInit) { return; }
            window.__imeiPopupInit = true;

            var activeField = null;
            var activeDot = null;

            function toLines(value) {
                return (value || '').split(',').map(function (s) { return s.trim(); }).filter(function (s) { return s.length; });
            }

            document.addEventListener('click', function (e) {
                if (!e.target.closest) { return; }

                var openBtn = e.target.closest('[data-imei-open]');
                if (openBtn) {
                    e.preventDefault();
                    var row = openBtn.closest('.billing-item-row');
                    activeField = row ? row.querySelector('[data-imei-field]') : null;
                    activeDot = openBtn.querySelector('[data-imei-dot]');
                    var d = document.getElementById('imei-dialog');
                    var ta = document.getElementById('imei-dialog-text');
                    if (!d || !ta) { return; }
                    ta.value = toLines(activeField ? activeField.value : '').join('\n');
                    if (typeof d.showModal === 'function') { d.showModal(); } else { d.setAttribute('open', ''); }
                    setTimeout(function () { ta.focus(); }, 0);
                    return;
                }

                if (e.target.closest('[data-imei-cancel]')) {
                    var dc = document.getElementById('imei-dialog');
                    if (dc) { dc.close ? dc.close() : dc.removeAttribute('open'); }
                    return;
                }

                if (e.target.closest('[data-imei-save]')) {
                    var ta2 = document.getElementById('imei-dialog-text');
                    var list = (ta2 ? ta2.value : '').split('\n').map(function (s) { return s.trim(); }).filter(function (s) { return s.length; });
                    var stored = list.join(', ');
                    if (activeField) {
                        activeField.value = stored;
                        activeField.dispatchEvent(new Event('input', { bubbles: true }));
                        activeField.dispatchEvent(new Event('change', { bubbles: true }));
                    }
                    if (activeDot) {
                        if (stored) { activeDot.removeAttribute('hidden'); } else { activeDot.setAttribute('hidden', ''); }
                    }
                    var ds = document.getElementById('imei-dialog');
                    if (ds) { ds.close ? ds.close() : ds.removeAttribute('open'); }
                    return;
                }
            });
        })();
    </script>
</div>
