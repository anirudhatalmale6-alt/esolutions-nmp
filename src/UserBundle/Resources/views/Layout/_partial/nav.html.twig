<aside class="profile-sidebar">
    <div class="profile-nav-card">
        <nav class="profile-nav">
            <a href="{{ path('_profile') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('profile') ? ' active' : '' }}">
                <span class="profile-nav-icon">
                    {{ ux_icon('tabler:user', {width: 20, height: 20}) }}
                </span>
                <span class="profile-nav-text">{{ 'Profile'|trans }}</span>
            </a>
            {# Getting verified is optional and is offered at the end of sign-up,
               so it has to be findable afterwards by somebody who said "later". #}
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('_verification') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('verification') ? ' active' : '' }}">
                    <span class="profile-nav-icon">
                        {{ ux_icon('tabler:id-badge-2', {width: 20, height: 20}) }}
                    </span>
                    <span class="profile-nav-text">{{ 'Get Verified'|trans }}</span>
                </a>
            {% endif %}
            {# "Stock Listing" now lives under the premium Marketplace item in the
               left sidebar (Marketplace > Share My Inventory) - its natural home. #}
            <a href="{{ path('_change_password') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('change-password') ? ' active' : '' }}">
                <span class="profile-nav-icon">
                    {{ ux_icon('tabler:lock', {width: 20, height: 20}) }}
                </span>
                <span class="profile-nav-text">{{ 'Change Password'|trans }}</span>
            </a>
            <a href="{{ path('_2fa_list') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('2fa') ? ' active' : '' }}">
                <span class="profile-nav-icon">
                    {{ ux_icon('tabler:shield-check', {width: 20, height: 20}) }}
                </span>
                <span class="profile-nav-text">{{ 'Two-Factor Authentication'|trans }}</span>
            </a>
            <a href="{{ path('_profile_notifications') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('notification') ? ' active' : '' }}">
                <span class="profile-nav-icon">
                    {{ ux_icon('tabler:bell', {width: 20, height: 20}) }}
                </span>
                <span class="profile-nav-text">{{ 'Notifications'|trans }}</span>
            </a>
            <a href="{{ path('_api_keys_index') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('api-tokens') ? ' active' : '' }}">
                <span class="profile-nav-icon">
                    {{ ux_icon('tabler:key', {width: 20, height: 20}) }}
                </span>
                <span class="profile-nav-text">{{ 'API Keys'|trans }}</span>
            </a>
            <a href="{{ path('mcp_connected_apps_list') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('connected-apps') ? ' active' : '' }}">
                <span class="profile-nav-icon">
                    {{ ux_icon('tabler:plug-connected', {width: 20, height: 20}) }}
                </span>
                <span class="profile-nav-text">{{ 'Connected Apps'|trans }}</span>
            </a>
            <a href="{{ path('_export_list') }}" class="profile-nav-item{{ menuItem is defined and menuItem is same as('data-export') ? ' active' : '' }}">
                <span class="profile-nav-icon">
                    {{ ux_icon('tabler:database-export', {width: 20, height: 20}) }}
                </span>
                <span class="profile-nav-text">{{ 'Data Export'|trans }}</span>
            </a>
        </nav>
    </div>
</aside>

