<div class="onboarding-step-card">
    {# Welcome Badge #}
    <div class="welcome-section">
        <div class="welcome-badge">
            {{ ux_icon('tabler:sparkles', {width: 16, height: 16}) }}
            {{ 'Welcome to %app_name%!'|trans({'%app_name%': app_name}) }}
        </div>
        <div class="step-icon">
            {{ ux_icon('tabler:building', {width: 32, height: 32, class: 'text-white'}) }}
        </div>
        <h2 class="h2 mb-2">{{ 'Tell us about your business'|trans }}</h2>
        <p class="text-muted lead mb-0">
            {{ 'Just once - this is what your invoices and your profile are built from.'|trans }}
        </p>
    </div>

    {{ form_start(form) }}
        <div class="mb-4">
            {{ form_row(form.company.companyName, {
                'attr': {
                    'class': 'form-control form-control-lg',
                }
            }) }}
        </div>

        <div class="mb-4">
            {{ form_row(form.company.fullName, {
                'attr': {'class': 'form-control'}
            }) }}
        </div>

        <div class="row">
            <div class="col-12 col-md-6 mb-4">
                {{ form_row(form.company.city, {
                    'attr': {'class': 'form-control'}
                }) }}
            </div>
            <div class="col-12 col-md-6 mb-4">
                {{ form_row(form.company.country, {
                    'attr': {'class': 'form-select', 'data-country-currency': 'true'}
                }) }}
            </div>
        </div>

        <div class="mb-4">
            {{ form_row(form.company.contactNumber, {
                'attr': {'class': 'form-control'}
            }) }}
        </div>

        <div class="mb-4">
            {{ form_row(form.company.companyCurrency, {
                'attr': {'class': 'form-select', 'data-currency-target': 'true'}
            }) }}
        </div>

        <div class="d-grid gap-2">
            {{ form_widget(form.navigator.next, {
                'attr': {'class': 'btn btn-primary btn-lg w-100'}
            }) }}
        </div>
    {{ form_end(form) }}
</div>

<script>
    // Picking a country almost always answers the currency question too, so fill
    // it in rather than asking twice. Only ever moves a currency the person has
    // not touched themselves - once they choose one by hand it is theirs, and a
    // later change of country must not quietly overwrite it.
    (function () {
        var country = document.querySelector('[data-country-currency]');
        var currency = document.querySelector('[data-currency-target]');

        if (!country || !currency) {
            return;
        }

        var byCountry = {
            AE: 'AED', SA: 'SAR', QA: 'QAR', KW: 'KWD', BH: 'BHD', OM: 'OMR',
            IN: 'INR', PK: 'PKR', BD: 'BDT', LK: 'LKR', NP: 'NPR',
            HK: 'HKD', CN: 'CNY', JP: 'JPY', KR: 'KRW', SG: 'SGD', MY: 'MYR',
            TH: 'THB', ID: 'IDR', PH: 'PHP', VN: 'VND', TW: 'TWD',
            GB: 'GBP', CH: 'CHF', TR: 'TRY', RU: 'RUB', EG: 'EGP', ZA: 'ZAR',
            NG: 'NGN', KE: 'KES', MA: 'MAD', DZ: 'DZD', TN: 'TND', JO: 'JOD',
            LB: 'LBP', IQ: 'IQD', IR: 'IRR', AF: 'AFN',
            US: 'USD', CA: 'CAD', MX: 'MXN', BR: 'BRL', AR: 'ARS',
            AU: 'AUD', NZ: 'NZD',
            AT: 'EUR', BE: 'EUR', CY: 'EUR', DE: 'EUR', EE: 'EUR', ES: 'EUR',
            FI: 'EUR', FR: 'EUR', GR: 'EUR', IE: 'EUR', IT: 'EUR', LT: 'EUR',
            LU: 'EUR', LV: 'EUR', MT: 'EUR', NL: 'EUR', PT: 'EUR', SI: 'EUR',
            SK: 'EUR', HR: 'EUR'
        };

        var touched = false;
        currency.addEventListener('change', function () {
            touched = true;
        });

        country.addEventListener('change', function () {
            if (touched) {
                return;
            }

            var code = byCountry[country.value];

            if (!code) {
                return;
            }

            // Only select it if this installation actually offers that currency.
            for (var i = 0; i < currency.options.length; i++) {
                if (currency.options[i].value === code) {
                    currency.selectedIndex = i;
                    return;
                }
            }
        });
    })();
</script>
