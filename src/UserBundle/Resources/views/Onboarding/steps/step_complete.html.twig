<div class="onboarding-step-card text-center">
    {# Success Animation #}
    <div class="celebration-icon mb-4">
        <div class="success-checkmark">
            {{ ux_icon('tabler:circle-check', {width: 96, height: 96, class: 'text-success'}) }}
        </div>
    </div>

    <h1 class="h1 mb-3">{{ 'You are in'|trans }}</h1>
    <p class="lead text-muted mb-4">
        {{ 'Your account is ready. One last thing worth doing now, and it takes two minutes.'|trans }}
    </p>

    {# The trusted badge. Deliberately the loudest thing on this page: it is what
       members are actually buying into - other businesses want to know who they
       are dealing with before they trade. It is still optional, and the plain
       link underneath says so. #}
    <div class="verify-invite text-start mb-4">
        <div class="d-flex align-items-start gap-3">
            {{ ux_icon('tabler:shield-check', {width: 28, height: 28, class: 'text-primary flex-shrink-0 mt-1'}) }}
            <div>
                <strong class="d-block mb-1">{{ 'Get your Trusted badge'|trans }}</strong>
                <p class="text-muted mb-3">
                    {{ 'Send in your national ID and passport and we will check them by hand. Verified members carry a badge other businesses can see, and it is what opens the marketplace and the other premium tools.'|trans }}
                </p>
                <a href="{{ path('_verification') }}" class="btn btn-primary">
                    {{ 'Get verified now'|trans }}
                </a>
            </div>
        </div>
    </div>

    {{ form_start(form) }}
        {{ form_widget(form.navigator.finish, {
            'label': 'I will do this later - take me in',
            'attr': {'class': 'btn btn-link text-muted w-100'}
        }) }}
    {{ form_end(form) }}

    <div class="mt-4 pt-3 border-top">
        <p class="text-muted small mb-0">
            {{ 'You can start this from your profile menu at any time.'|trans }}
        </p>
    </div>
</div>

<style>
    .celebration-icon {
        animation: celebrate 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }

    @keyframes celebrate {
        0% {
            transform: scale(0) rotate(-180deg);
            opacity: 0;
        }
        50% {
            transform: scale(1.1) rotate(10deg);
        }
        100% {
            transform: scale(1) rotate(0deg);
            opacity: 1;
        }
    }

    .success-checkmark {
        position: relative;
    }

    .success-checkmark::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 120px;
        height: 120px;
        border-radius: 50%;
        background: rgba(40, 167, 69, 0.1);
        animation: pulse 1.5s ease-in-out infinite;
    }

    @keyframes pulse {
        0%, 100% {
            transform: translate(-50%, -50%) scale(1);
            opacity: 0.5;
        }
        50% {
            transform: translate(-50%, -50%) scale(1.1);
            opacity: 0.3;
        }
    }

    .verify-invite {
        background: #f8f9fa;
        border-radius: 0.75rem;
        padding: 1.5rem;
        border-left: 3px solid #066fd1;
    }
</style>
