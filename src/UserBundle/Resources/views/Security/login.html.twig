{% extends '@Ui/Security/login.html.twig' %}

{% block page_title %}{{ app_name }} - {{ "security.login.login"|trans }}{% endblock page_title %}

{% block stylesheets %}
    {{ parent() }}

    {{ encore_entry_link_tags('login') }}

    {# B2B Network brand background - a dark charcoal with a soft gold glow,
       matching the logo, instead of the generic stock photo. #}
    <style>
        body .page {
            background: radial-gradient(1100px 620px at 50% -12%, rgba(201,162,75,.20), transparent 60%), #1b1e25 !important;
            background-size: cover !important;
        }
    </style>
{% endblock stylesheets %}

{% block social_login %}
    {% toggle 'google_oauth_login' %}
        <div class="hr-text">{{ 'security.login.or'|trans }}</div>

        <div class="card-body">
            <div class="row">
                <div class="col">
                    <a href="{{ path('_oauth_connect', {'service': 'google' }) }}" class="btn btn-outline-secondary w-100">
                        {{ ux_icon('tabler:brand-google', {width: 24, height: 24}) }}
                        {{ 'security.login.login_with_google'|trans }}
                    </a>
                </div>
            </div>
        </div>
    {% endtoggle %}
{% endblock social_login %}

{% block content %}
    <div class="text-center mb-4">
        <span class="navbar-brand d-inline-flex align-items-center mb-0">
            <img src="{{ asset('images/b2b-logo-light.png') }}" alt="{{ app_name }}" style="height:58px;width:auto">
        </span>
    </div>

    {{ parent() }}

    <div class="text-center text-secondary mt-3 bg-white p-2">
        {{ 'security.login.no_account'|trans }}
        <a href="{{ path('_register') }}" tabindex="-1">
            {{ 'security.login.register_now'|trans }}
        </a>
    </div>
{% endblock content %}
