{% extends '@SolidInvoiceCore/Layout/base.html.twig' %}

{% block page_title %}{{ app_name }} - {{ 'Registration by invitation only'|trans }}{% endblock page_title %}

{% block body %}
    <div class="registration-closed-page">
        <div class="registration-closed-card">
            <div class="registration-closed-icon">
                {{ ux_icon('tabler:shield-lock', {width: 40, height: 40}) }}
            </div>
            <h1 class="registration-closed-title">{{ 'Joining is by invitation only'|trans }}</h1>
            <p class="registration-closed-text">
                {{ 'The B2B Network is a curated, invite-only platform. New businesses can only join through an official invite link from a member of our sales team.'|trans }}
            </p>
            <p class="registration-closed-text">
                {{ 'Please contact the B2B Network Team for activation, and we will send you your personal join link.'|trans }}
            </p>
            <a href="/login" class="registration-closed-btn">
                {{ ux_icon('tabler:arrow-left', {width: 18, height: 18, class: 'me-1'}) }}{{ 'Back to sign in'|trans }}
            </a>
        </div>
    </div>

    <style>
        .registration-closed-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            background: radial-gradient(1200px 600px at 50% -10%, #2a2a2e 0%, #17181b 55%, #101114 100%);
        }
        .registration-closed-card {
            width: 100%;
            max-width: 460px;
            background: #1d1e22;
            border: 1px solid rgba(244, 196, 48, .25);
            border-radius: 16px;
            padding: 40px 34px;
            text-align: center;
            box-shadow: 0 20px 60px rgba(0, 0, 0, .45);
        }
        .registration-closed-icon {
            width: 76px;
            height: 76px;
            margin: 0 auto 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #f4c430;
            background: rgba(244, 196, 48, .12);
            border: 1px solid rgba(244, 196, 48, .3);
        }
        .registration-closed-title {
            color: #f5f5f5;
            font-size: 1.5rem;
            font-weight: 700;
            margin: 0 0 14px;
        }
        .registration-closed-text {
            color: #b8b9be;
            font-size: .975rem;
            line-height: 1.6;
            margin: 0 0 14px;
        }
        .registration-closed-btn {
            display: inline-flex;
            align-items: center;
            margin-top: 10px;
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 600;
            text-decoration: none;
            color: #17181b;
            background: #f4c430;
            transition: background .15s ease;
        }
        .registration-closed-btn:hover {
            background: #ffd966;
            color: #17181b;
        }
    </style>
{% endblock %}
